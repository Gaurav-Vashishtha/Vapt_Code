# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep

# Ignore vendored third-party code, but keep the directory.
/vendor/*
!/vendor/.keep

/public/assets
.byebug_history

# Ignore master key for decrypting credentials and more.
/config/master.key

/public/packs
/public/packs-test
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity
.env
.DS_Store
stats.json
replace_url.sh
find-heavy-imports.sh
replace_url.sh
public/script_chunks/*

# Ignore things related to the new js app
/notifik-js-app/node_modules

# Ignore build outputs (generated artifacts)
/public/notifik-js-app/*
/public/notifik-svelte-app/*
rabbitpay-admin/rabbit-dashboard/node_modules/*
rabbitpay-admin/rabbit-dashboard/node_modules/.bin/*
rabbitpay-admin/rabbit-dashboard/node_modules/.vite/deps/*
