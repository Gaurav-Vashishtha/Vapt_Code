<div class="px-4 pb-4 pt-1 bg-gray-50">
  <div class="flex flex-wrap gap-3 mb-3 text-xs">
    <% if crisp_url.present? %><%= link_to "Crisp chat", crisp_url, target: "_blank", class: "text-sky-600 hover:underline" %><% end %>
    <% if admin_path.present? %><%= link_to "Open in DB", admin_path, target: "_blank", class: "text-sky-600 hover:underline" %><% end %>
    <% if store_url.present? %><%= link_to "Open store", store_url, target: "_blank", class: "text-sky-600 hover:underline" %><% end %>
    <span class="text-gray-500">Last contact: <%= last_contact ? last_contact.strftime("%d %b %Y") : "never" %></span>
    <% reminders.each do |r| %>
      <span class="text-amber-700">Callback <%= r.due_on.strftime("%d %b") %></span>
    <% end %>
  </div>

  <div class="flex flex-wrap items-start gap-x-6 gap-y-2 mb-3 text-xs">
    <div class="flex items-center gap-1.5">
      <span class="font-semibold text-gray-600">Plan:</span>
      <span class="text-gray-800"><%= local_assigns[:plan_label].presence || "—" %></span>
      <% if local_assigns[:plan_label].present? %>
        <span class="px-1.5 py-0.5 rounded-full <%= local_assigns[:plan_active] ? "bg-emerald-100 text-emerald-700" : "bg-gray-100 text-gray-500" %>">
          <%= local_assigns[:plan_active] ? "Billing active" : "Not activated" %>
        </span>
      <% end %>
    </div>
    <div class="flex-1 min-w-[220px]">
      <span class="font-semibold text-gray-600 align-middle">Features enabled:</span>
      <% feats = local_assigns[:features] || [] %>
      <% if feats.present? %>
        <% feats.each do |feature| %>
          <span class="inline-block px-1.5 py-0.5 mr-1 mb-1 rounded-full bg-sky-50 text-sky-700 border border-sky-100"><%= feature %></span>
        <% end %>
      <% else %>
        <span class="text-gray-400">None enabled</span>
      <% end %>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-4">
    <div class="bg-white rounded-md border border-gray-200 p-3">
      <p class="text-xs font-semibold text-gray-600 mb-2">Log outcome</p>
      <%= form_tag call_calendar_outcome_path(date: @date), method: :post, class: "flex flex-wrap items-center gap-2" do %>
        <%= hidden_field_tag :shopify_domain, domain %>
        <%= hidden_field_tag :shop_id, shop_id %>
        <%= hidden_field_tag :segment, segment %>
        <%= hidden_field_tag :call_target_id, call_target_id %>
        <%= hidden_field_tag :cps, cps %>
        <%= hidden_field_tag :tab, params[:tab] %>
        <%= hidden_field_tag :cb_team, params[:cb_team] %>
        <%= select_tag :outcome, options_for_select(CallRecord::OUTCOME_LABELS.map { |k, v| [v, k] }), class: "text-xs border border-gray-300 rounded px-2 py-1" %>
        <%= render 'agent_field' %>
        <%= text_field_tag :notes, nil, placeholder: "Note", class: "text-xs border border-gray-300 rounded px-2 py-1 flex-1 min-w-[120px]" %>
        <%= submit_tag "Log", class: "text-xs bg-gray-900 text-white rounded px-3 py-1 cursor-pointer" %>
      <% end %>
    </div>

    <div class="bg-white rounded-md border border-gray-200 p-3">
      <p class="text-xs font-semibold text-gray-600 mb-2">Set callback</p>
      <%= form_tag call_calendar_reminder_path(date: @date), method: :post, class: "flex flex-wrap items-center gap-2" do %>
        <%= hidden_field_tag :shopify_domain, domain %>
        <%= hidden_field_tag :shop_id, shop_id %>
        <%= hidden_field_tag :tab, params[:tab] %>
        <%= hidden_field_tag :cb_team, params[:cb_team] %>
        <%= date_field_tag :due_on, (@date + 7), class: "text-xs border border-gray-300 rounded px-2 py-1" %>
        <%= select_tag :team, options_for_select([["Support team", "support"], ["Sales team", "sales"]], (local_assigns[:default_team] || "support")), class: "text-xs border border-gray-300 rounded px-2 py-1" %>
        <%= render 'agent_field' %>
        <%= text_field_tag :note, nil, placeholder: "Note", class: "text-xs border border-gray-300 rounded px-2 py-1 flex-1 min-w-[120px]" %>
        <%= submit_tag "Schedule", class: "text-xs bg-sky-600 text-white rounded px-3 py-1 cursor-pointer" %>
      <% end %>
    </div>

    <div class="bg-white rounded-md border border-gray-200 p-3">
      <p class="text-xs font-semibold text-gray-600 mb-2">Add comment</p>
      <%= form_tag call_calendar_comment_path(date: @date), method: :post, class: "flex flex-wrap items-center gap-2" do %>
        <%= hidden_field_tag :shopify_domain, domain %>
        <%= hidden_field_tag :shop_id, shop_id %>
        <%= hidden_field_tag :tab, params[:tab] %>
        <%= hidden_field_tag :cb_team, params[:cb_team] %>
        <%= render 'agent_field' %>
        <%= text_field_tag :comment, nil, placeholder: "Comment", class: "text-xs border border-gray-300 rounded px-2 py-1 flex-1 min-w-[140px]" %>
        <%= submit_tag "Add", class: "text-xs bg-gray-700 text-white rounded px-3 py-1 cursor-pointer" %>
      <% end %>
    </div>

    <div class="bg-white rounded-md border border-gray-200 p-3">
      <p class="text-xs font-semibold text-gray-600 mb-2">Suppress / skip</p>
      <div class="flex flex-wrap items-center gap-2">
        <%= form_tag call_calendar_suppress_path(date: @date), method: :post, class: "flex items-center gap-2" do %>
          <%= hidden_field_tag :shopify_domain, domain %>
          <%= hidden_field_tag :tab, params[:tab] %>
          <%= hidden_field_tag :cb_team, params[:cb_team] %>
          <%= select_tag :reason, options_for_select(CallSuppression::REASONS.map { |r| [r.tr("_", " "), r] }), class: "text-xs border border-gray-300 rounded px-2 py-1" %>
          <%= render 'agent_field' %>
          <%= submit_tag "Suppress", class: "text-xs bg-red-600 text-white rounded px-3 py-1 cursor-pointer" %>
        <% end %>
        <% if call_target_id.present? %>
          <%= form_tag call_calendar_skip_path(call_target_id, date: @date), method: :post do %>
            <%= submit_tag "Skip", class: "text-xs border border-gray-300 text-gray-700 rounded px-3 py-1 cursor-pointer" %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <p class="text-xs font-semibold text-gray-600 mb-2">Timeline</p>
    <% if events.empty? %>
      <p class="text-xs text-gray-400">No activity yet.</p>
    <% else %>
      <ul class="space-y-1">
        <% events.each do |event| %>
          <li class="text-xs text-gray-600">
            <span class="text-gray-400"><%= event.occurred_at.strftime("%d %b %H:%M") %></span>
            · <span class="font-medium"><%= event.event_type.tr("_", " ") %></span>
            <% if event.agent_name.present? %>by <%= event.agent_name %><% end %>
            <% detail = event.payload["label"] || event.payload["comment"] || event.payload["reason"] || event.payload["due_on"] %>
            <% if detail.present? %>— <%= detail %><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
