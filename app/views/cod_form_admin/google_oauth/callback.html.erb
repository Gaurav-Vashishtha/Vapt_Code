<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Google Sheets</title>
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; padding: 48px 24px; text-align: center; color: #1a1a1a; }
      p { font-size: 15px; line-height: 1.5; }
    </style>
  </head>
  <body>
    <% if @ok %>
      <p>Google Sheets is connected. You can close this window.</p>
    <% else %>
      <p>Google Sheets could not be connected. Close this window and try again.</p>
    <% end %>
    <script>
      (function () {
        var message = { type: "codkf:google_sheets", ok: <%= @ok ? "true" : "false" %> };
        try { if (window.opener) { window.opener.postMessage(message, "*"); } } catch (e) {}
        <% if @ok %>setTimeout(function () { window.close(); }, 600);<% end %>
      })();
    </script>
  </body>
</html>
