<!DOCTYPE html>
<html>
<head>
  <title>Email Tool - Scheduled Emails</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
<div class="min-h-screen bg-gray-50">
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div>
          <h1 class="text-xl font-semibold text-gray-900">Email Tool</h1>
          <p class="text-sm text-gray-500">Schedule emails by rules (shops &amp; settings)</p>
        </div>
        <div class="flex gap-2">
          <%= link_to "Support Dashboard", support_dashboard_path, class: "flex items-center gap-2 border border-gray-300 rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
          <%= link_to email_tool_path, class: "flex items-center gap-2 bg-white border border-gray-300 rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            Refresh
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%= render "email_tool/shared/navigation" %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <% if flash[:notice] %><p class="mb-4 p-3 rounded bg-green-100 text-green-800"><%= flash[:notice] %></p><% end %>
    <% if flash[:alert] %><p class="mb-4 p-3 rounded bg-red-100 text-red-800"><%= flash[:alert] %></p><% end %>
    <%= yield %>
  </div>
</div>
</body>
</html>
