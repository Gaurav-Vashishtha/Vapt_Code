<!DOCTYPE html>
<html>
<head>
  <title>Engagement Dashboard - Support Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div>
          <h1 class="text-xl font-semibold text-gray-900">Support Dashboard</h1>
          <p class="text-sm text-gray-500">Team Engagement Report</p>
        </div>
      </div>
    </div>
  </div>

  <%= render 'shared/support_navigation' %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Navigation -->
    <div class="mb-6">
      <%= link_to support_dashboard_path, class: "text-blue-600 hover:text-blue-800 text-sm" do %>
        ← Back to Dashboard
      <% end %>
    </div>

    <!-- Content -->
    <div class="bg-white rounded-lg shadow">
      <div class="border-b border-gray-200 p-6">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
          <div>
            <h2 class="text-lg font-medium text-gray-900 mb-1">Team Engagement Report</h2>
            <p class="text-sm text-gray-600">
              Track team member engagement across all support activities
            </p>
          </div>
          
          <!-- Date Filter -->
          <div class="flex items-center gap-3">
            <%= form_with url: engagement_dashboard_path, method: :get, local: true, class: "flex items-center gap-2" do |f| %>
              <label class="text-sm text-gray-600">Date Range:</label>
              <%= f.date_field :end_date, value: @end_date, class: "px-3 py-2 border border-gray-300 rounded-md text-sm" %>
              <%= f.select :days, options_for_select(@quick_filters.map { |f| [f[:label], f[:days]] }, @days), {}, { class: "px-3 py-2 border border-gray-300 rounded-md text-sm" } %>
              <%= f.submit "Filter", class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
            <% end %>
          </div>
        </div>
        
        <!-- Quick Filters -->
        <div class="mt-4 flex flex-wrap gap-2">
          <% @quick_filters.each do |filter| %>
            <%= link_to filter[:label], engagement_dashboard_path(days: filter[:days], end_date: @end_date),
                class: "px-3 py-1 rounded-md text-sm font-medium #{ @days == filter[:days] ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' }" %>
          <% end %>
        </div>
      </div>

      <div class="p-6">
        <!-- Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <div class="text-sm text-blue-600 font-medium mb-1">Team Members</div>
            <div class="text-2xl font-bold text-blue-900"><%= @summary[:total_team_members] %></div>
          </div>
          <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <div class="text-sm text-green-600 font-medium mb-1">Verify Setups</div>
            <div class="text-2xl font-bold text-green-900"><%= @summary[:total_verify_setups] %></div>
          </div>
          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
            <div class="text-sm text-yellow-600 font-medium mb-1">Potential Leads</div>
            <div class="text-2xl font-bold text-yellow-900"><%= @summary[:total_potential_leads] %></div>
          </div>
          <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
            <div class="text-sm text-purple-600 font-medium mb-1">Callbacks</div>
            <div class="text-2xl font-bold text-purple-900"><%= @summary[:total_callbacks] %></div>
          </div>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <div class="text-sm text-red-600 font-medium mb-1">Uninstalled</div>
            <div class="text-2xl font-bold text-red-900"><%= @summary[:total_uninstalled_shops] %></div>
          </div>
          <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-4">
            <div class="text-sm text-indigo-600 font-medium mb-1">Total Engagement</div>
            <div class="text-2xl font-bold text-indigo-900"><%= @summary[:total_engagement_shops] %></div>
          </div>
        </div>

        <!-- Date Range Info -->
        <div class="mb-6 p-4 bg-gray-50 rounded-lg">
          <p class="text-sm text-gray-600">
            Showing data from <strong><%= @start_date.strftime('%B %d, %Y') %></strong> to <strong><%= @end_date.strftime('%B %d, %Y') %></strong>
          </p>
        </div>

        <!-- Engagement Table -->
        <% if @engagement_data.any? %>
          <div class="overflow-x-auto shadow ring-1 ring-black ring-opacity-5 rounded-lg">
            <table class="min-w-full divide-y divide-gray-300">
              <thead class="bg-gray-50">
                <tr>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Team Member</th>
                  <th class="py-3.5 px-6 text-center text-xs font-medium text-gray-500 uppercase tracking-wide">Verify Setups</th>
                  <th class="py-3.5 px-6 text-center text-xs font-medium text-gray-500 uppercase tracking-wide">Potential Leads</th>
                  <th class="py-3.5 px-6 text-center text-xs font-medium text-gray-500 uppercase tracking-wide">Callbacks</th>
                  <th class="py-3.5 px-6 text-center text-xs font-medium text-gray-500 uppercase tracking-wide">Uninstalled Shops</th>
                  <th class="py-3.5 px-6 text-center text-xs font-medium text-gray-500 uppercase tracking-wide">Total Engagement</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @engagement_data.each do |data| %>
                  <tr class="hover:bg-gray-50">
                    <td class="py-4 px-6">
                      <div class="flex items-center">
                        <div class="w-10 h-10 rounded-full bg-blue-500 flex items-center justify-center text-white text-sm font-medium">
                          <%= data[:name][0..1].upcase %>
                        </div>
                        <div class="ml-3">
                          <div class="font-medium text-gray-900"><%= data[:name] %></div>
                        </div>
                      </div>
                    </td>
                    <td class="py-4 px-6 text-center">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-medium bg-green-100 text-green-800">
                        <%= data[:verify_setups_done] %>
                      </span>
                    </td>
                    <td class="py-4 px-6 text-center">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                        <%= data[:potential_leads_contacted] %>
                      </span>
                    </td>
                    <td class="py-4 px-6 text-center">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
                        <%= data[:callbacks_attended] %>
                      </span>
                    </td>
                    <td class="py-4 px-6 text-center">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-medium bg-red-100 text-red-800">
                        <%= data[:uninstalled_shops] %>
                      </span>
                    </td>
                    <td class="py-4 px-6 text-center">
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold bg-indigo-100 text-indigo-900">
                        <%= data[:total_engagement_shops] %>
                      </span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-12">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No engagement data</h3>
            <p class="mt-1 text-sm text-gray-500">No team member engagement found for the selected date range.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
</body>
</html>

