<!DOCTYPE html>
<html>
<head>
  <title>Scheduled merchant reports (global definitions)</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
<div class="min-h-screen bg-gray-50">
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div>
          <h1 class="text-xl font-semibold text-gray-900">Global scheduled reports</h1>
          <p class="text-sm text-gray-500">Define reports once (SQL or built-in generators). Merchants opt in per shop; SQL is never visible in the embedded app.</p>
        </div>
        <%= link_to support_dashboard_path,
            class: "text-sm text-blue-600 hover:text-blue-800" do %>
          ← Support home
        <% end %>
      </div>
    </div>
  </div>

  <%= render "shared/support_navigation" %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <% if flash[:notice].present? %>
      <div class="mb-4 rounded-md bg-green-50 p-4 text-sm text-green-800"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert].present? %>
      <div class="mb-4 rounded-md bg-red-50 p-4 text-sm text-red-800"><%= flash[:alert] %></div>
    <% end %>

    <div class="flex justify-end mb-4">
      <%= link_to "New global report",
          new_support_dashboard_scheduled_report_path,
          class: "bg-gray-900 hover:bg-gray-800 text-white px-4 py-2 rounded-md text-sm font-medium" %>
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Slug</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Name</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Admin SQL</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Format</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Schedule</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Type</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @definitions.each do |d| %>
            <tr>
              <td class="px-4 py-3 text-sm font-mono text-gray-900"><%= d.slug %></td>
              <td class="px-4 py-3 text-sm text-gray-900"><%= d.name %></td>
              <td class="px-4 py-3 text-sm">
                <% if d.sql_text.present? %>
                  <span class="text-green-700 font-medium">Yes (overrides built-in when set)</span>
                <% else %>
                  <span class="text-gray-400">Default (code or requires SQL)</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700"><%= d.output_format %></td>
              <td class="px-4 py-3 text-sm text-gray-700">
                <%= d.schedule_frequency == "weekly" ? "Weekly (merchant picks day and time)" : "Daily (merchant picks time)" %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700"><%= d.builtin? ? "Built-in" : "Custom" %></td>
              <td class="px-4 py-3 text-sm space-x-3 whitespace-nowrap">
                <%= link_to "Edit", edit_support_dashboard_scheduled_report_path(d),
                    class: "text-blue-600 hover:text-blue-800" %>
                <%= link_to "Test email", test_deliver_support_dashboard_scheduled_report_path(d),
                    class: "text-blue-600 hover:text-blue-800" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-sm text-gray-600">
      For <strong>built-in</strong> slugs, leaving SQL empty uses the app’s default generator. Pasting SQL runs your query for every subscriber shop (still must include <code class="bg-gray-100 px-1 rounded">{{shop_id}}</code> in SQL reports).
      Use <strong>Test email</strong> to run the report against a sample shop without changing merchant settings.
    </p>
  </div>
</div>
</body>
</html>
