<!DOCTYPE html>
<html>
<head>
  <title>Support Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div>
          <h1 class="text-xl font-semibold text-gray-900">Support Dashboard</h1>
          <p class="text-sm text-gray-500">Monitor and manage merchant support requests</p>
        </div>
        <%= link_to support_dashboard_path, 
            class: "flex items-center gap-2 bg-white border border-gray-300 rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          Refresh
        <% end %>
      </div>
    </div>
  </div>

 
  <%= render 'shared/support_navigation' %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6 mb-8">
      <div class="bg-sky-50 rounded-lg p-6 border border-gray-200">
        <div class="flex items-center gap-3 mb-2">
          <svg class="w-5 h-5 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
          <span class="text-sm font-medium text-gray-600">Support leads</span>
        </div>
        <div class="text-2xl font-bold text-gray-900"><%= @support_lead_queue_count %></div>
        <div class="text-sm text-gray-500 mt-1">Mature store + recent install (default filters)</div>
        <%= link_to "Open queue", support_dashboard_support_lead_queue_path, class: "mt-2 inline-block text-sm text-sky-700 font-medium hover:underline" %>
      </div>

      <div class="bg-emerald-50 rounded-lg p-6 border border-gray-200">
        <div class="flex items-center gap-3 mb-2">
          <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          <span class="text-sm font-medium text-gray-600">Active stores</span>
        </div>
        <div class="text-2xl font-bold text-gray-900 min-h-[2rem] flex items-center gap-2 flex-wrap">
          <span id="active-stores-count-display" class="text-gray-400">—</span>
          <span id="active-stores-count-loading" class="hidden text-sm font-normal text-gray-500">Loading…</span>
        </div>
        <button type="button" id="active-stores-count-btn"
          class="mt-2 inline-flex items-center rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">
          Show count
        </button>
        <p id="active-stores-count-error" class="hidden mt-1 text-sm text-red-600"></p>
        <div class="text-sm text-gray-500 mt-1">Plan + charge, settings, &gt;10 confirmations (30d)</div>
      </div>

      <div class="bg-red-50 rounded-lg p-6 border border-gray-200">
        <div class="flex items-center gap-3 mb-2">
          <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
          <span class="text-sm font-medium text-gray-600">Uninstalled Follow-ups</span>
        </div>
        <div class="text-2xl font-bold text-gray-900"><%= @uninstalled_count %></div>
        <div class="text-sm text-gray-500 mt-1">High-value churned shops</div>
      </div>

      <div class="bg-yellow-50 rounded-lg p-6 border border-gray-200">
        <div class="flex items-center gap-3 mb-2">
          <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
          </svg>
          <span class="text-sm font-medium text-gray-600">Follow-ups</span>
        </div>
        <div class="text-2xl font-bold text-gray-900"><%= @pending_followups_count %></div>
        <div class="text-sm text-gray-500 mt-1">Awaiting resolution</div>
      </div>
      <div class="bg-teal-50 rounded-lg p-6 border border-gray-200">
        <div class="flex items-center gap-3 mb-2">
          <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 1.567-3 3.5S10.343 15 12 15s3-1.567 3-3.5S13.657 8 12 8zm0 0V5m0 10v3m7-7h3m-3 0h-3m-8 0H5m3 0H5"></path>
          </svg>
          <span class="text-sm font-medium text-gray-600">Callbacks</span>
        </div>
        <div class="text-2xl font-bold text-gray-900"><%= @callbacks_count %></div>
        <div class="text-sm text-gray-500 mt-1">Scheduled last 7 days</div>
      </div>
      <div class="bg-purple-50 rounded-lg p-6 border border-gray-200">
        <div class="flex items-center gap-3 mb-2">
          <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
          <span class="text-sm font-medium text-gray-600">WhatsApp Integration</span>
        </div>
        <div class="text-2xl font-bold text-gray-900"><%= @whatsapp_integration_requests_count %></div>
        <div class="text-sm text-gray-500 mt-1">Pending requests</div>
      </div>
      <div class="bg-cyan-50 rounded-lg p-6 border border-gray-200">
        <div class="flex items-center gap-3 mb-2">
          <svg class="w-5 h-5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6M7 4h10a2 2 0 012 2v12a2 2 0 01-2 2H7a2 2 0 01-2-2V6a2 2 0 012-2z"></path>
          </svg>
          <span class="text-sm font-medium text-gray-600">SMS Template Approvals</span>
        </div>
        <div class="text-2xl font-bold text-gray-900"><%= @sms_template_approvals_count %></div>
        <div class="text-sm text-gray-500 mt-1">Pending reviews</div>
      </div>
      <div class="bg-indigo-50 rounded-lg p-6 border border-gray-200">
        <div class="flex items-center gap-3 mb-2">
          <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <span class="text-sm font-medium text-gray-600">Calls today</span>
        </div>
        <div class="text-2xl font-bold text-gray-900"><%= @calls_attempted_today %>/<%= @calls_target_today %></div>
        <%= link_to "Open call calendar", support_dashboard_call_calendar_path, class: "mt-2 inline-block text-sm text-indigo-700 font-medium hover:underline" %>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="bg-white rounded-lg shadow">
      <div class="border-b border-gray-200">
        <nav class="flex flex-wrap gap-x-4 px-6">
          <%= link_to support_dashboard_support_lead_queue_path,
              class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if request.path.include?('support_lead_queue')} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless request.path.include?('support_lead_queue')}" do %>
            Support leads
          <% end %>
          <%= link_to support_dashboard_uninstalled_path,
              class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if request.path.include?('uninstalled')} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless request.path.include?('uninstalled')}" do %>
            Uninstalled Follow-ups
          <% end %>
          <%= link_to support_dashboard_followups_path,
              class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if request.path.include?('followups')} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless request.path.include?('followups')}" do %>
            Follow-ups
          <% end %>
          <%= link_to support_dashboard_callbacks_path,
              class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if request.path.include?('callbacks')} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless request.path.include?('callbacks')}" do %>
            Callbacks
          <% end %>
          <%= link_to support_dashboard_whatsapp_integration_requests_path,
              class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if request.path.include?('whatsapp_integration_requests')} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless request.path.include?('whatsapp_integration_requests')}" do %>
            WhatsApp Integration
          <% end %>
          <%= link_to support_dashboard_sms_template_approvals_path,
              class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if request.path.include?('sms_template_approvals')} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless request.path.include?('sms_template_approvals')}" do %>
            SMS Template Approvals
          <% end %>
          <%= link_to support_dashboard_whatsapp_languages_path,
              class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if request.path.include?('whatsapp_languages')} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless request.path.include?('whatsapp_languages')}" do %>
            WhatsApp Languages
          <% end %>
          <%= link_to engagement_dashboard_path,
              class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if request.path.include?('engagement')} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless request.path.include?('engagement')}" do %>
            Engagement
          <% end %>
          <%= link_to email_tool_path,
              class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if request.path.include?('email_tool')} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless request.path.include?('email_tool')}" do %>
            Email Tool
          <% end %>
          <%= link_to support_dashboard_scheduled_reports_path,
              class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if request.path.include?('scheduled_reports')} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless request.path.include?('scheduled_reports')}" do %>
            Global reports (SQL)
          <% end %>
          <%= link_to support_dashboard_scheduled_report_deliveries_path,
              class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if request.path.include?('scheduled_report_deliveries')} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless request.path.include?('scheduled_report_deliveries')}" do %>
            Report deliveries
          <% end %>
          <%= link_to support_dashboard_call_calendar_path,
              class: "py-4 px-1 border-b-2 font-medium text-sm #{'border-blue-500 text-blue-600' if request.path.include?('call_calendar')} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' unless request.path.include?('call_calendar')}" do %>
            Call Calendar
          <% end %>
        </nav>
      </div>

    </div>
  </div>
</div>
<script>
(function () {
  var btn = document.getElementById('active-stores-count-btn');
  var display = document.getElementById('active-stores-count-display');
  var loading = document.getElementById('active-stores-count-loading');
  var errEl = document.getElementById('active-stores-count-error');
  if (!btn || !display) return;

  function setLoading(on) {
    if (loading) loading.classList.toggle('hidden', !on);
    btn.disabled = on;
    btn.classList.toggle('opacity-50', on);
    btn.classList.toggle('cursor-not-allowed', on);
  }

  function showError(msg) {
    if (errEl) {
      errEl.textContent = msg || 'Failed to load count';
      errEl.classList.remove('hidden');
    }
  }

  function hideError() {
    if (errEl) errEl.classList.add('hidden');
  }

  btn.addEventListener('click', function () {
    hideError();
    setLoading(true);
    display.textContent = '';

    fetch('<%= support_dashboard_active_stores_count_path %>', {
      method: 'GET',
      credentials: 'same-origin',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
      .then(function (res) {
        if (!res.ok) return res.json().then(function (body) {
          throw new Error((body && body.error) || res.statusText);
        });
        return res.json();
      })
      .then(function (data) {
        if (typeof data.count === 'number') {
          display.textContent = data.count.toLocaleString();
          display.classList.remove('text-gray-400');
          btn.textContent = 'Refresh count';
        } else {
          throw new Error('Invalid response');
        }
      })
      .catch(function (e) {
        display.textContent = '—';
        showError(e.message || 'Could not load count');
      })
      .finally(function () {
        setLoading(false);
      });
  });
})();
</script>
</body>
</html>