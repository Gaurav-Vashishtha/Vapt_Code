<div class="space-y-3">
  <% entries = follow_up_entries(shop, source_tab) %>
  <% open_entries = entries.select { |entry| entry[:status] == :pending } %>
  <% history_entries = entries.select { |entry| entry[:status] == :resolved } %>

  <% if open_entries.any? %>
    <div class="space-y-2">
      <% open_entries.each do |entry| %>
        <div class="border border-gray-200 rounded-md p-3 bg-gray-50">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-medium text-gray-600"><%= follow_up_entry_header(entry) %></span>
            <span class="text-[10px] uppercase tracking-wide px-2 py-0.5 rounded-full <%= follow_up_status_badge_classes(entry) %>">
              <%= entry[:status].to_s.titleize %>
            </span>
          </div>
          <div class="text-sm text-gray-900 break-words">
            <%= follow_up_entry_body(entry) %>
          </div>

          <!-- Comments Section -->
          <% follow_up_obj = FollowUp.find_by(id: entry[:follow_up_id]) %>
          <% if follow_up_obj %>
            <% comments = follow_up_obj.follow_up_comments.oldest_first %>
            <% if comments.any? %>
              <div class="mt-3 border border-blue-100 bg-blue-50 rounded-md p-2">
                <p class="text-xs font-medium text-gray-700 mb-2">Comments</p>
                <div class="space-y-1.5">
                  <% comments.each do |comment| %>
                    <div class="bg-white rounded p-1.5 border border-blue-200">
                      <p class="text-xs text-gray-900"><%= comment.comment %></p>
                      <p class="text-[10px] text-gray-500 mt-0.5">
                        <%= comment.created_at.strftime("%b %d, %Y %I:%M %p") %>
                      </p>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- Comment Form -->
            <div class="mt-3 border border-gray-200 bg-gray-50 rounded-md p-2">
              <p class="text-xs font-medium text-gray-700 mb-2">Add Comment</p>
              <%= form_with url: support_dashboard_follow_up_comments_path(follow_up_obj),
                  scope: :follow_up_comment, method: :post, local: true, class: "space-y-2" do |f| %>
                <%= f.text_area :comment,
                    rows: 2,
                    required: true,
                    placeholder: "Add a comment...",
                    class: "w-full px-2 py-1.5 border border-gray-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-blue-500" %>
                <div class="flex items-center gap-2">
                  <%= f.text_field :commented_by,
                      placeholder: "Your name (optional)",
                      class: "flex-1 px-2 py-1.5 border border-gray-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-blue-500" %>
                  <%= f.submit "Add Comment",
                      class: "bg-blue-600 hover:bg-blue-700 text-white px-2 py-1.5 rounded-md text-xs font-medium" %>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if entry[:status] == :pending %>
            <div class="mt-3 space-y-2">
              <p class="text-xs font-medium text-gray-600">Resolve follow-up</p>
              <%= form_with url: resolve_support_dashboard_follow_up_path(entry[:follow_up_id]),
                  scope: :follow_up, method: :patch, local: true, class: "space-y-2" do |f| %>
                <%= hidden_field_tag :resolved_source_tab, source_tab %>
                <%= f.text_area :resolved_notes,
                    rows: 2,
                    required: true,
                    placeholder: "Add resolution note...",
                    class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
                <div class="flex items-center gap-2">
                  <%= f.text_field :resolved_by,
                      placeholder: "Your name (optional)",
                      class: "flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
                  <%= f.submit "Resolve",
                      class: "bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded-md text-sm font-medium" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-gray-400">No open follow-ups.</p>
  <% end %>

  <% if history_entries.any? %>
    <details class="mt-4">
      <summary class="text-sm font-medium text-gray-700 cursor-pointer">View History (<%= history_entries.count %>)</summary>
      <div class="space-y-2 mt-3">
        <% history_entries.each do |entry| %>
          <div class="border border-gray-200 rounded-md p-3 bg-white">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-medium text-gray-600"><%= follow_up_entry_header(entry) %></span>
              <span class="text-[10px] uppercase tracking-wide px-2 py-0.5 rounded-full <%= follow_up_status_badge_classes(entry) %>">
                <%= entry[:status].to_s.titleize %>
              </span>
            </div>
            <div class="text-sm text-gray-900 break-words">
              <%= follow_up_entry_body(entry) %>
            </div>

            <!-- Comments Section for Resolved Follow-ups -->
            <% follow_up_obj = FollowUp.find_by(id: entry[:follow_up_id]) %>
            <% if follow_up_obj %>
              <% comments = follow_up_obj.follow_up_comments.oldest_first %>
              <% if comments.any? %>
                <div class="mt-2 border border-blue-100 bg-blue-50 rounded-md p-2">
                  <p class="text-xs font-medium text-gray-700 mb-2">Comments</p>
                  <div class="space-y-1.5">
                    <% comments.each do |comment| %>
                      <div class="bg-white rounded p-1.5 border border-blue-200">
                        <p class="text-xs text-gray-900"><%= comment.comment %></p>
                        <p class="text-[10px] text-gray-500 mt-0.5">
                          <%= comment.created_at.strftime("%b %d, %Y %I:%M %p") %>
                        </p>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <!-- Comment Form for Resolved Follow-ups -->
              <div class="mt-2 border border-gray-200 bg-gray-50 rounded-md p-2">
                <p class="text-xs font-medium text-gray-700 mb-2">Add Comment</p>
                <%= form_with url: support_dashboard_follow_up_comments_path(follow_up_obj),
                    scope: :follow_up_comment, method: :post, local: true, class: "space-y-2" do |f| %>
                  <%= f.text_area :comment,
                      rows: 2,
                      required: true,
                      placeholder: "Add a comment...",
                      class: "w-full px-2 py-1.5 border border-gray-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-blue-500" %>
                  <div class="flex items-center gap-2">
                    <%= f.text_field :commented_by,
                        placeholder: "Your name (optional)",
                        class: "flex-1 px-2 py-1.5 border border-gray-300 rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-blue-500" %>
                    <%= f.submit "Add Comment",
                        class: "bg-blue-600 hover:bg-blue-700 text-white px-2 py-1.5 rounded-md text-xs font-medium" %>
                  </div>
                <% end %>
              </div>
            <% end %>

            <% if entry[:resolved_by].present? %>
              <p class="text-xs text-gray-500 mt-1">Resolved by <%= entry[:resolved_by] %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>

  <%= form_with url: follow_up_create_path(shop), scope: :follow_up, method: :post, local: true, class: "space-y-2" do |f| %>
    <%= hidden_field_tag :source_tab, source_tab %>
    <%= f.text_field :created_by,
        placeholder: "Your name *",
        required: true,
        class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    <%= f.text_area :notes,
        rows: 2,
        required: true,
        placeholder: "Add follow-up note...",
        class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    <%= f.submit "Add Follow-up",
        class: "bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-md text-sm" %>
  <% end %>

  <details class="mt-4">
    <summary class="text-sm font-medium text-gray-700 cursor-pointer">Resolve Lead Immediately</summary>
    <div class="mt-3 space-y-2">
      <%= form_with url: follow_up_create_path(shop), scope: :follow_up, method: :post, local: true, class: "space-y-2" do |f| %>
        <%= hidden_field_tag :source_tab, source_tab %>
        <%= hidden_field_tag :resolve_immediately, true %>
        <%= f.text_field :created_by,
            placeholder: "Your name *",
            required: true,
            class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
        <%= f.text_area :resolved_notes,
            rows: 3,
            required: true,
            placeholder: "Add resolution notes...",
            class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
        <%= f.text_field :resolved_by,
            placeholder: "Your name (optional)",
            class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
        <%= f.submit "Resolve Lead",
            class: "bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded-md text-sm font-medium" %>
      <% end %>
    </div>
  </details>
</div>

