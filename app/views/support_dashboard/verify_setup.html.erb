<!DOCTYPE html>
<html>
<head>
  <title>Support Dashboard - Potential Leads</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div>
          <h1 class="text-xl font-semibold text-gray-900">Support Dashboard</h1>
          <p class="text-sm text-gray-500">Monitor and manage merchant support requests</p>
        </div>
        <%= link_to support_dashboard_verify_setup_path, 
            class: "flex items-center gap-2 bg-white border border-gray-300 rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          Refresh
        <% end %>
      </div>
    </div>
  </div>

  <%= render 'shared/support_navigation' %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Navigation -->
    <div class="mb-6">
      <%= link_to support_dashboard_path, class: "text-blue-600 hover:text-blue-800 text-sm" do %>
        ← Back to Dashboard
      <% end %>
    </div>

    <!-- Content -->
    <div class="bg-white rounded-lg shadow">
      <div class="border-b border-gray-200">
        <nav class="flex flex-wrap gap-x-6 px-6">
          <%= render "support_dashboard/core_support_tabs", active: :verify_setup %>
        </nav>
      </div>

      <div class="p-6">
        <div class="mb-6">
          <h2 class="text-lg font-medium text-gray-900 mb-2">Potential Leads Requiring Setup Verification</h2>
          <p class="text-sm text-gray-600">
            Recent shops (last 7 days) and older shops (3+ months) without assigned Notes
          </p>
        </div>

        <% if @shops.any? %>
          <div class="overflow-x-auto shadow ring-1 ring-black ring-opacity-5 rounded-lg">
            <table class="min-w-full divide-y divide-gray-300">
              <thead class="bg-gray-50">
                <tr>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Shop Domain</th>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Shopify Plan</th>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Plan</th>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Shop Created Date</th>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Owner Phone</th>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Notes</th>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Actions</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @shops.each do |shop| %>
                  <tr class="border-b border-gray-100 hover:bg-gray-50">
                    <td class="py-4 px-6">
                      <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-purple-500 flex items-center justify-center text-white text-sm font-medium">
                          <%= shop.shopify_domain[0..1].upcase %>
                        </div>
                        <div>
                          <div class="font-medium text-gray-900">
                            <%= link_to "https://#{shop.shopify_domain}", "https://#{shop.shopify_domain}", 
                                target: "_blank", 
                                class: "text-blue-600 hover:text-blue-800 hover:underline" %>
                          </div>
                          <div class="text-sm text-gray-500"><%= shop.shop_owner || 'Shopify Store' %></div>
                        </div>
                      </div>
                    </td>
                
                    <td class="py-4 px-6">
                      <% if shop.shopify_plan.present? %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                          <%= case shop.shopify_plan.downcase
                              when 'basic', 'shopify lite'
                                'bg-green-100 text-green-800'
                              when 'shopify', 'professional'
                                'bg-blue-100 text-blue-800'
                              when 'advanced', 'unlimited'
                                'bg-purple-100 text-purple-800'
                              when 'plus', 'shopify plus'
                                'bg-orange-100 text-orange-800'
                              else
                                'bg-gray-100 text-gray-800'
                              end %>">
                          <%= shop.shopify_plan.titleize %>
                        </span>
                      <% else %>
                        <span class="text-sm text-gray-400">Unknown</span>
                      <% end %>
                    </td>
                    <td class="py-4 px-6">
                      <% if shop.plan.present? %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
                          <%= shop.plan.name %>
                        </span>
                      <% else %>
                        <span class="text-sm text-gray-400">No plan</span>
                      <% end %>
                    </td>
                    <td class="py-4 px-6 text-sm text-gray-500">
                      <% 
                        begin
                          if shop.shop_created_date.present?
                            # Convert to DateTime if it's a string
                            date = shop.shop_created_date.is_a?(String) ? DateTime.parse(shop.shop_created_date) : shop.shop_created_date
                            if date.respond_to?(:strftime)
                      %>
                              <div><%= date.strftime("%b %d, %Y") %></div>
                              <div class="text-xs"><%= date.strftime("%I:%M %p") %></div>
                      <%    else %>
                              <span class="text-gray-400">Invalid date format</span>
                      <%    end
                          else %>
                            <span class="text-gray-400">Not available</span>
                      <%  end
                        rescue ArgumentError, TypeError => e %>
                          <span class="text-gray-400">Invalid date</span>
                      <% end %>
                    </td>
                    <td class="py-4 px-6">
                      <% if shop.owner_phone.present? %>
                        <div class="text-sm text-gray-900"><%= shop.owner_phone %></div>
                        <div class="text-xs text-gray-500">Verified</div>
                      <% else %>
                        <span class="text-sm text-gray-400">Not provided</span>
                      <% end %>
                    </td>
                    <td class="py-4 px-6">
                      <%= render partial: "support_dashboard/follow_up_column", locals: { shop: shop, source_tab: "Potential Leads" } %>
                    </td>
                    <td class="py-4 px-6">
                      <div class="flex items-center gap-2">
                        <%= link_to "/admin/shops/#{shop.id}", 
                            target: "_blank",
                            class: "bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded-md text-sm font-medium" do %>
                          View
                        <% end %>
                        <%= link_to shop.crisp_url, 
                            target: "_blank",
                            class: "bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded-md text-sm font-medium" do %>
                          Contact
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <div class="mt-6">
            <%= paginate @shops if respond_to?(:paginate) %>
          </div>
        <% else %>
          <div class="text-center py-12">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No shops need verification</h3>
            <p class="mt-1 text-sm text-gray-500">All recent and older shops have assigned Notes.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
</body>
</html>