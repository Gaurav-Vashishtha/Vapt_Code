<%# locals: f (form builder for SupportLeadTracking) %>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-1 text-xs">
  <% [
    [:activated, "Activated"],
    [:verified_setup, "Verified setup"],
    [:contacted, "Contacted"],
    [:reminder_1_sent, "Reminder 1 sent"],
    [:reminder_2_sent, "Reminder 2 sent"],
    [:reminder_3_sent, "Reminder 3 sent"],
    [:not_interested, "Not interested"],
    [:onboarded_to_free_plan, "Onboarded — free plan"],
    [:onboarded_to_paid_plan, "Onboarded — paid plan"]
  ].each do |field, label| %>
    <label class="inline-flex items-center gap-2 cursor-pointer">
      <%= f.check_box field, class: "rounded border-gray-300" %>
      <span><%= label %></span>
    </label>
  <% end %>
</div>

<div class="mt-3">
  <label class="block text-xs font-medium text-gray-600 mb-1">Reassign engineer</label>
  <% pool = SupportLeadTracking.engineer_pool %>
  <% options = [["— Unassigned —", ""]] + pool.map { |n| [n, n] } %>
  <%= f.select :assigned_engineer,
      options_for_select(options, f.object&.assigned_engineer),
      {},
      class: "border rounded px-2 py-1 text-sm w-full max-w-xs" %>
</div>

<div class="mt-3">
  <label class="block text-xs font-medium text-gray-600 mb-1">Comment (one per lead)</label>
  <%= f.text_area :comment,
      rows: 2,
      class: "w-full border rounded px-2 py-1 text-sm",
      placeholder: "Add a note… (saved on Save row)" %>
</div>
