<!DOCTYPE html>
<html>
<head>
  <title>Support Dashboard - Create Custom Follow-up</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div>
          <h1 class="text-xl font-semibold text-gray-900">Support Dashboard</h1>
          <p class="text-sm text-gray-500">Create a custom follow-up</p>
        </div>
      </div>
    </div>
  </div>

  <%= render 'shared/support_navigation' %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Navigation -->
    <div class="mb-6">
      <%= link_to support_dashboard_followups_path, class: "text-blue-600 hover:text-blue-800 text-sm" do %>
        ← Back to Follow-ups
      <% end %>
    </div>

    <!-- Content -->
    <div class="bg-white rounded-lg shadow">
      <div class="border-b border-gray-200">
        <nav class="flex flex-wrap gap-x-6 px-6">
          <%= render "support_dashboard/core_support_tabs", active: :followups %>
        </nav>
      </div>

      <div class="p-6">
        <div class="mb-6">
          <h2 class="text-lg font-medium text-gray-900 mb-1">Create Custom Follow-up</h2>
          <p class="text-sm text-gray-600">
            Create a follow-up for any shop by entering the shopify domain.
          </p>
        </div>

        <% if flash[:alert] %>
          <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-md">
            <p class="text-sm text-red-800"><%= flash[:alert] %></p>
          </div>
        <% end %>

        <%= form_with url: create_custom_follow_up_path, scope: :follow_up, method: :post, local: true, class: "space-y-6" do |f| %>
          <div>
            <label for="shopify_domain" class="block text-sm font-medium text-gray-700 mb-2">
              Shopify Domain <span class="text-red-500">*</span>
            </label>
            <%= text_field_tag :shopify_domain, params[:shopify_domain], 
                placeholder: "example.myshopify.com or example",
                required: true,
                class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
            <p class="mt-1 text-xs text-gray-500">Enter the shop domain (with or without .myshopify.com)</p>
          </div>

          <div>
            <label for="source_tab" class="block text-sm font-medium text-gray-700 mb-2">
              Source Tab
            </label>
            <%= text_field_tag :source_tab, params[:source_tab] || "Custom Follow-up",
                placeholder: "Custom Follow-up",
                class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
            <p class="mt-1 text-xs text-gray-500">The context or tab name for this follow-up (default: "Custom Follow-up")</p>
          </div>

          <div>
            <label for="follow_up_created_by" class="block text-sm font-medium text-gray-700 mb-2">
              Your Name <span class="text-red-500">*</span>
            </label>
            <%= f.text_field :created_by,
                required: true,
                placeholder: "Enter your name...",
                class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>

          <div>
            <label for="follow_up_notes" class="block text-sm font-medium text-gray-700 mb-2">
              Notes <span class="text-red-500">*</span>
            </label>
            <%= f.text_area :notes,
                rows: 4,
                required: true,
                placeholder: "Enter follow-up notes...",
                class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>

          <div class="border-t border-gray-200 pt-6">
            <h3 class="text-sm font-medium text-gray-900 mb-4">Optional: Resolve Immediately</h3>
            <div class="space-y-4">
              <div class="flex items-center">
                <%= check_box_tag :resolve_immediately, "1", params[:resolve_immediately] == "1",
                    class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
                <label for="resolve_immediately" class="ml-2 block text-sm text-gray-700">
                  Resolve this follow-up immediately
                </label>
              </div>

              <div id="resolve-fields" class="<%= 'hidden' unless params[:resolve_immediately] == '1' %> space-y-4">
                <div>
                  <label for="follow_up_resolved_notes" class="block text-sm font-medium text-gray-700 mb-2">
                    Resolution Notes
                  </label>
                  <%= f.text_area :resolved_notes,
                      rows: 3,
                      placeholder: "Enter resolution notes...",
                      class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
                </div>

                <div>
                  <label for="follow_up_resolved_by" class="block text-sm font-medium text-gray-700 mb-2">
                    Resolved By
                  </label>
                  <%= f.text_field :resolved_by,
                      placeholder: "Your name (optional)",
                      class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
                </div>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
            <%= f.submit "Create Follow-up",
                class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
            <%= link_to "Cancel", support_dashboard_followups_path,
                class: "bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-md text-sm font-medium" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const resolveCheckbox = document.getElementById('resolve_immediately');
    const resolveFields = document.getElementById('resolve-fields');
    
    if (resolveCheckbox && resolveFields) {
      resolveCheckbox.addEventListener('change', function() {
        if (this.checked) {
          resolveFields.classList.remove('hidden');
        } else {
          resolveFields.classList.add('hidden');
        }
      });
    }
  });
</script>
</body>
</html>

