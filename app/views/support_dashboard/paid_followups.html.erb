<!DOCTYPE html>
<html>
<head>
  <title>Support Dashboard - Paid Followups</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div>
          <h1 class="text-xl font-semibold text-gray-900">Support Dashboard</h1>
          <p class="text-sm text-gray-500">Monitor and manage merchant support requests</p>
        </div>
        <%= link_to support_dashboard_paid_followups_path,
            class: "flex items-center gap-2 bg-white border border-gray-300 rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          Refresh
        <% end %>
      </div>
    </div>
  </div>

  <%= render 'shared/support_navigation' %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Navigation -->
    <div class="mb-6">
      <%= link_to support_dashboard_path, class: "text-blue-600 hover:text-blue-800 text-sm" do %>
        ← Back to Dashboard
      <% end %>
    </div>

    <!-- Content -->
    <div class="bg-white rounded-lg shadow">
      <div class="border-b border-gray-200">
        <nav class="flex flex-wrap gap-x-6 px-6">
          <%= render "support_dashboard/core_support_tabs", active: :paid_followups %>
        </nav>
      </div>

      <div class="p-6">
        <div class="mb-6">
          <h2 class="text-lg font-medium text-gray-900 mb-2">Paid followups</h2>
          <p class="text-sm text-gray-600">All shops where plan name is not <code>free</code>.</p>
          <p class="text-sm text-gray-500 mt-1">Total: <%= @total_count %></p>
        </div>

        <div class="mb-4 flex flex-wrap gap-2">
          <% [["pending", "Pending"], ["resolved", "Resolved"], ["all", "All"]].each do |val, label| %>
            <%= link_to label,
                support_dashboard_paid_followups_path(status: val),
                class: "px-4 py-2 rounded-md text-sm font-medium #{@status_filter == val ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
          <% end %>
        </div>

        <% if @shops.any? %>
          <div class="overflow-x-auto shadow ring-1 ring-black ring-opacity-5 rounded-lg">
            <table class="min-w-full divide-y divide-gray-300">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Shop</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Plan</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Installed</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Follow-up</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @shops.each do |shop| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm font-medium text-gray-900"><%= shop.shopify_domain %></div>
                      <div class="text-sm text-gray-500">ID: <%= shop.id %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm font-medium text-gray-900"><%= shop.plan&.name %></div>
                      <div class="text-sm text-gray-500"><%= shop.plan&.price %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <%= shop.created_at&.strftime("%b %d, %Y") %>
                    </td>
                    <td class="px-6 py-4">
                      <%= render partial: "support_dashboard/follow_up_column", locals: { shop: shop, source_tab: "Paid followups" } %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="mt-6">
            <%= paginate @shops %>
          </div>
        <% else %>
          <div class="text-center py-12">
            <p class="text-gray-500">No shops found for this filter.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
</body>
</html>

