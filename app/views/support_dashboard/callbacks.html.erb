<!DOCTYPE html>
<html>
<head>
  <title>Support Dashboard - Callbacks</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div>
          <h1 class="text-xl font-semibold text-gray-900">Support Dashboard</h1>
          <p class="text-sm text-gray-500">Monitor and manage merchant support requests</p>
        </div>
        <%= link_to support_dashboard_callbacks_path,
            class: "flex items-center gap-2 bg-white border border-gray-300 rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          Refresh
        <% end %>
      </div>
    </div>
  </div>

  <%= render 'shared/support_navigation' %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Navigation -->
    <div class="mb-6">
      <%= link_to support_dashboard_path, class: "text-blue-600 hover:text-blue-800 text-sm" do %>
        ← Back to Dashboard
      <% end %>
    </div>

    <!-- Content -->
    <div class="bg-white rounded-lg shadow">
      <div class="border-b border-gray-200">
        <nav class="flex flex-wrap gap-x-6 px-6">
          <%= render "support_dashboard/core_support_tabs", active: :callbacks %>
        </nav>
      </div>

      <div class="p-6">
        <div class="mb-6">
          <h2 class="text-lg font-medium text-gray-900 mb-2">Scheduled Callbacks (Last 7 Days)</h2>
          <p class="text-sm text-gray-600">
            Review merchants requesting a callback and manage their follow-up/resolution history.
          </p>
        </div>

        <% if @callback_requests.any? %>
          <div class="overflow-x-auto shadow ring-1 ring-black ring-opacity-5 rounded-lg">
            <table class="min-w-full divide-y divide-gray-300">
              <thead class="bg-gray-50">
                <tr>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Shop Domain</th>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Contact</th>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Preferred Time</th>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Notes</th>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Status</th>
                  <th class="py-3.5 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Follow-ups</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @callback_requests.each do |request| %>
                  <% shop = @follow_up_targets[request.shop_domain] %>
                  <% pending_follow_up = (@follow_up_targets[request.shop_domain]&.follow_ups&.pending&.first) %>
                  <tr class="border-b border-gray-100 hover:bg-gray-50">
                    <td class="py-4 px-6 whitespace-nowrap">
                      <div class="flex flex-col">
                        <%= link_to request.shop_domain, "https://#{request.shop_domain}",
                            target: "_blank",
                            class: "text-blue-600 hover:text-blue-800 hover:underline break-all font-medium" %>
                        <span class="text-xs text-gray-500">Requested <%= time_ago_in_words(request.created_at) %> ago</span>
                      </div>
                    </td>
                    <td class="py-4 px-6">
                      <div class="text-sm text-gray-900 font-medium"><%= request.name %></div>
                      <div class="text-sm text-gray-600"><%= mail_to request.email %></div>
                      <div class="text-sm text-gray-600"><%= request.phone_number %></div>
                    </td>
                    <td class="py-4 px-6">
                      <div class="text-sm text-gray-900"><%= request.preferred_time.presence || "Anytime" %></div>
                      <div class="text-xs text-gray-500"><%= request.timezone.presence || "N/A" %></div>
                    </td>
                    <td class="py-4 px-6 text-sm text-gray-900">
                      <%= request.notes.presence || "No additional notes" %>
                    </td>
                    <td class="py-4 px-6">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= request.status == 'resolved' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                        <%= request.status.titleize %>
                      </span>
                    </td>
                    <td class="py-4 px-6">
                      <% if shop.present? %>
                        <%= render partial: "support_dashboard/follow_up_column", locals: { shop: shop, source_tab: "Callbacks" } %>
                      <% elsif request.status == 'resolved' %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                          Resolved
                        </span>
                      <% elsif pending_follow_up.present? %>
                        <div class="text-sm text-gray-500 mb-2">
                          Follow-up created but shop record missing.
                        </div>
                        <%= button_to "Mark Resolved", resolve_support_dashboard_callback_request_path(request),
                            method: :patch,
                            form: { data: { turbo_confirm: "Mark this callback as resolved?", confirm: "Mark this callback as resolved?" } },
                            class: "bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded-md text-xs font-medium" %>
                      <% else %>
                        <div class="text-sm text-gray-500 mb-2">
                          No linked shop found. Please ensure the shop exists to track follow-ups.
                        </div>
                        <%= button_to "Mark Resolved", resolve_support_dashboard_callback_request_path(request),
                            method: :patch,
                            form: { data: { turbo_confirm: "Mark this callback as resolved?", confirm: "Mark this callback as resolved?" } },
                            class: "bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded-md text-xs font-medium" %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="mt-6">
            <%= paginate @callback_requests if respond_to?(:paginate) %>
          </div>
        <% else %>
          <div class="text-center py-12">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No callback requests</h3>
            <p class="mt-1 text-sm text-gray-500">No callbacks scheduled in the last 7 days.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
</body>
</html>

