<%= content_tag :div,
  id: "hello-react",
  data: {
    name: 'Settings',
    setting: @setting,
    shop: @shop.as_json(except: %i[shopify_token shopify_refresh_token rabbit_pay_token]).merge("whatsapp_bsp_exempt" => @shop.whatsapp_bsp_plan_exempt?),
    plan: @plan,
    crisp_url: @crisp_url,
    visible_plans: @visible_plans,
    session: @current_shopify_session,
    scope_refresh_url: @scope_refresh_url,
    twilio_pricing: @twilio_pricing,
    needs_bootstrap: @needs_bootstrap,
    reconnected: @reconnected
}.to_json do %>
<% end %>