<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @email_heading %></title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f1f5f9;
      -webkit-font-smoothing: antialiased;
    }
    .wrap {
      max-width: 640px;
      margin: 0 auto;
      padding: 32px 20px 48px;
    }
    .card {
      background: #ffffff;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      padding: 28px 24px 32px;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
    }
    .brand-logo-wrap {
      text-align: center;
      margin: 0 0 24px;
    }
    .brand-logo {
      display: inline-block;
      max-width: 200px;
      height: auto;
      vertical-align: middle;
    }
    h1 {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 22px;
      font-weight: 600;
      color: #0f172a;
      margin: 0 0 12px;
      line-height: 1.3;
    }
    .divider {
      height: 1px;
      background: #e2e8f0;
      margin: 24px 0;
    }
    .report-content {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 15px;
      line-height: 1.55;
      color: #334155;
    }
    .report-content p {
      margin: 0 0 14px;
    }
    .report-content table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
      margin: 16px 0;
      color: #334155;
    }
    .report-content th,
    .report-content td {
      border: 1px solid #e2e8f0;
      padding: 10px 12px;
      text-align: left;
      vertical-align: top;
    }
    .report-content th {
      background: #f8fafc;
      font-weight: 600;
      color: #0f172a;
    }
    .report-content pre {
      font-family: ui-monospace, "Cascadia Code", "SF Mono", Menlo, Monaco, Consolas, monospace;
      font-size: 13px;
      line-height: 1.5;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 16px;
      margin: 16px 0;
      overflow-x: auto;
      white-space: pre-wrap;
      word-break: break-word;
      color: #334155;
    }
    .attachment-note {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 13px;
      color: #64748b;
      margin: 20px 0 0;
      padding: 12px 14px;
      background: #f8fafc;
      border-radius: 8px;
      border: 1px solid #e2e8f0;
    }
    .footer {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 12px;
      color: #94a3b8;
      margin-top: 24px;
      line-height: 1.5;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <% if @brand_logo_url.present? %>
        <div class="brand-logo-wrap">
          <img src="<%= h @brand_logo_url %>" alt="COD King" class="brand-logo" width="200">
        </div>
      <% end %>
      <h1><%= ERB::Util.html_escape(@email_heading) %></h1>

      <div class="divider"></div>

      <div class="report-content">
        <%= @report_body_html %>
      </div>

      <% if @has_csv_attachment %>
        <p class="attachment-note">
          A CSV file is attached to this message with additional detail where applicable.
        </p>
      <% end %>

      <% if @manage_reports_url.present? %>
        <p class="footer" style="margin-top: 16px;">
          <a href="<%= h @manage_reports_url %>" style="color: #334155;">Manage or turn off this report</a> in COD King → Reports.
        </p>
      <% end %>

      <p class="footer">
        This report was sent by COD King on behalf of your store settings.<br>
        Question? mail to <a href="mailto:support@notifiktech.com" style="color: #64748b;">support@notifiktech.com</a> or contact support via in app chat support.
      </p>
    </div>
  </div>
</body>
</html>
