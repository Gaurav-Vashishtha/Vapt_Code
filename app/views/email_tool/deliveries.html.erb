<div class="flex justify-between items-center mb-4">
  <h2 class="text-lg font-semibold text-gray-900">Deliveries</h2>
  <div class="flex items-center gap-3">
    <%= link_to "Open stats", email_tool_delivery_open_stats_path, class: "text-sm text-blue-600 hover:text-blue-800" %>
    <div class="flex gap-2">
    <%= link_to "All", email_tool_deliveries_path(status: "all"), class: "px-3 py-1 rounded text-sm #{@status_filter == 'all' ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-700'}" %>
    <%= link_to "Pending", email_tool_deliveries_path(status: "pending"), class: "px-3 py-1 rounded text-sm #{@status_filter == 'pending' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-700'}" %>
    <%= link_to "Sent", email_tool_deliveries_path(status: "sent"), class: "px-3 py-1 rounded text-sm #{@status_filter == 'sent' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-700'}" %>
    <%= link_to "Skipped", email_tool_deliveries_path(status: "skipped"), class: "px-3 py-1 rounded text-sm #{@status_filter == 'skipped' ? 'bg-gray-200 text-gray-800' : 'bg-gray-100 text-gray-700'}" %>
    <%= link_to "Failed", email_tool_deliveries_path(status: "failed"), class: "px-3 py-1 rounded text-sm #{@status_filter == 'failed' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-700'}" %>
    <%= link_to "Rescheduled", email_tool_deliveries_path(status: "rescheduled"), class: "px-3 py-1 rounded text-sm #{@status_filter == 'rescheduled' ? 'bg-purple-100 text-purple-800' : 'bg-gray-100 text-gray-700'}" %>
    </div>
  </div>
</div>
<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Rule</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Shop</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Scheduled / Sent</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Opened / Clicks</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Error</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @deliveries.each do |d| %>
        <tr>
          <td class="px-6 py-4 text-sm"><%= d.email_rule&.name %> (<%= d.email_rule&.slug %>)</td>
          <td class="px-6 py-4 text-sm"><%= d.recipient_label %></td>
          <td class="px-6 py-4 text-sm"><span class="px-2 py-0.5 rounded text-xs <%= case d.status when 'sent' then 'bg-green-100 text-green-800' when 'pending' then 'bg-yellow-100 text-yellow-800' when 'failed' then 'bg-red-100 text-red-800' when 'skipped' then 'bg-gray-100 text-gray-600' when 'rescheduled' then 'bg-purple-100 text-purple-800' else 'bg-gray-100' end %>"><%= d.status %></span></td>
          <td class="px-6 py-4 text-sm text-gray-600"><%= d.scheduled_at ? d.scheduled_at.in_time_zone(d.recipient_time_zone_name).strftime("%b %d, %H:%M") : "—" %> / <%= d.sent_at ? d.sent_at.in_time_zone(d.recipient_time_zone_name).strftime("%b %d, %H:%M") : "—" %></td>
          <td class="px-6 py-4 text-sm text-gray-600"><%= d.opened_at ? "Opened #{d.opened_at.strftime("%b %d, %H:%M")}" : "—" %> / <%= d.email_click_redirects.count { |r| r.clicked_at.present? } %> clicks</td>
          <td class="px-6 py-4 text-sm text-gray-600 max-w-xs truncate" title="<%= d.error_message %>"><%= d.error_message %></td>
          <td class="px-6 py-4 text-sm">
            <%= button_to "Delete", email_tool_delivery_destroy_path(d), method: :delete, data: { confirm: "Delete this scheduled email? The rule can create a new pending delivery for this shop later." }, class: "text-red-600 hover:text-red-800 text-sm font-medium" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="px-6 py-3 border-t border-gray-200"><%= paginate @deliveries %></div>
</div>
