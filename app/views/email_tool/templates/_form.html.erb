<%= form_with model: template, url: submit_url, local: true, class: "bg-white rounded-lg shadow p-6 max-w-2xl" do |f| %>
  <% if template.errors.any? %>
    <div class="mb-4 p-3 rounded bg-red-50 text-red-800 text-sm"><%= template.errors.full_messages.join(", ") %></div>
  <% end %>
  <div class="space-y-4">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
    </div>
    <div>
      <%= f.label :subject, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :subject, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2", placeholder: "Use {{shop.shopify_domain}}, {{setting.column}}" %>
    </div>
    <div>
      <%= f.label :body, "Body (HTML)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :body, rows: 12, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 font-mono text-sm", placeholder: "Use {{shop.owner_email}}, {{setting.enable_pre_order_otp}}, etc." %>
    </div>
    <div class="flex gap-2 items-center">
      <%= f.submit submit_label, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
      <% if template.persisted? %>
        <%= link_to "Preview", email_tool_templates_preview_path(template_id: template.id), target: "_blank", class: "bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-md text-sm font-medium" %>
      <% end %>
      <%= link_to "Cancel", email_tool_templates_path, class: "bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-md text-sm font-medium" %>
    </div>
  </div>
<% end %>
