<!DOCTYPE html>
<html>
<head>
  <title>Payout Management - Referral Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <%= render 'layouts/referral_admin_navigation' %>
  
  <div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-white">Payout Management</h1>
      <div class="flex space-x-3">
        <%= link_to "Create New Payout", new_referral_admin_payout_path, 
            class: "bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
        <%= link_to "Pending Summary", pending_summary_referral_admin_payouts_path, 
            class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
      </div>
    </div>
    
    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-700">Pending Payouts</h3>
        <p class="text-3xl font-bold text-orange-600">
          $<%= number_with_precision(@summary[:total_pending], precision: 2) %>
        </p>
        <small class="text-gray-500"><%= @summary[:pending_count] %> payouts</small>
      </div>
      
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-700">Completed Payouts</h3>
        <p class="text-3xl font-bold text-green-600">
          $<%= number_with_precision(@summary[:total_completed], precision: 2) %>
        </p>
        <small class="text-gray-500"><%= @summary[:completed_count] %> payouts</small>
      </div>
      
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-700">This Month</h3>
        <p class="text-3xl font-bold text-blue-600">
          $<%= number_with_precision(@summary[:total_this_month] || 0, precision: 2) %>
        </p>
        <small class="text-gray-500"><%= Date.current.strftime('%B %Y') %></small>
      </div>
      
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-700">Processing</h3>
        <p class="text-3xl font-bold text-purple-600">
          <%= @summary[:processing_count] || 0 %>
        </p>
        <small class="text-gray-500">payouts in progress</small>
      </div>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <%= form_with url: referral_admin_payouts_path, method: :get, local: true, class: "flex flex-wrap gap-4 items-end" do |f| %>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
          <%= f.select :status, options_for_select([
            ['All Statuses', ''],
            ['Pending', 'pending'],
            ['Processing', 'processing'],
            ['Completed', 'completed'],
            ['Failed', 'failed'],
            ['Cancelled', 'cancelled']
          ], params[:status]), {}, { class: "border border-gray-300 rounded px-3 py-2" } %>
        </div>
        
        <div>
          <%= f.submit "Filter", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
          <%= link_to "Clear", referral_admin_payouts_path, 
              class: "bg-gray-300 text-gray-700 px-4 py-2 rounded hover:bg-gray-400" %>
        </div>
      <% end %>
    </div>
    
    <!-- Payouts Table -->
    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b">
        <h3 class="text-xl font-bold text-gray-800">Recent Payouts</h3>
      </div>
      
      <% if @payouts.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Partner</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payout Date</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @payouts.each do |payout| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    <%= link_to payout.id, referral_admin_payout_path(payout), 
                        class: "text-blue-600 hover:text-blue-800" %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div>
                      <%= link_to payout.referral_partner.name, referral_admin_partner_path(payout.referral_partner), class: "text-sm font-medium text-blue-600 hover:text-blue-800 hover:underline" %>
                      <div class="text-sm text-gray-500"><%= payout.referral_partner.email %></div>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="text-lg font-semibold text-green-600">
                      $<%= number_with_precision(payout.total_amount, precision: 2) %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 py-1 text-xs font-semibold rounded-full 
                      <%= case payout.status
                          when 'pending' then 'bg-yellow-100 text-yellow-800'
                          when 'processing' then 'bg-blue-100 text-blue-800'
                          when 'completed' then 'bg-green-100 text-green-800'
                          when 'failed', 'cancelled' then 'bg-red-100 text-red-800'
                          else 'bg-gray-100 text-gray-800'
                          end %>">
                      <%= payout.status&.humanize || 'Unknown' %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= payout.payout_date&.strftime('%m/%d/%Y') || 'Not set' %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= payout.created_at&.strftime('%m/%d/%Y') || 'Unknown' %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                    <%= link_to "View", referral_admin_payout_path(payout), 
                        class: "text-blue-600 hover:text-blue-800" %>
                    
                    <% if payout.status == 'pending' %>
                      <%= link_to "Process", process_payout_referral_admin_payout_path(payout), 
                          method: :patch, 
                          class: "text-green-600 hover:text-green-800",
                          confirm: "Process this payout for $#{number_with_precision(payout.total_amount, precision: 2)}?" %>
                      
                      <%= link_to "Cancel", cancel_referral_admin_payout_path(payout), 
                          method: :patch, 
                          class: "text-red-600 hover:text-red-800 ml-2",
                          confirm: "Cancel this payout?" %>
                    <% elsif payout.status == 'processing' %>
                      <span class="text-blue-500">Processing...</span>
                    <% elsif payout.status == 'completed' %>
                      <span class="text-green-500">✓ Completed</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-12">
          <h3 class="text-lg font-medium text-gray-900 mb-2">No payouts found</h3>
          <p class="text-gray-500 mb-4">Create your first payout to get started.</p>
          <%= link_to "Create Payout", new_referral_admin_payout_path, 
              class: "bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700" %>
        </div>
      <% end %>
    </div>
  </div>
</body>
</html>