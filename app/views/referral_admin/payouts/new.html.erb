<!DOCTYPE html>
<html>
<head>
  <title>Create Payout - Referral Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <%= render 'layouts/referral_admin_navigation' %>
  
  <div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-gray-800">Create New Payout</h1>
      <%= link_to "← Back to Payouts", referral_admin_payouts_path, 
          class: "bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700" %>
    </div>
    
    <!-- Partners with Pending Earnings -->
    <div class="bg-white rounded-lg shadow mb-8">
      <div class="px-6 py-4 border-b">
        <h3 class="text-xl font-bold text-gray-800">Partners with Pending Earnings</h3>
      </div>
      
      <div class="p-6">
        <!-- Bulk Payout Form -->
        <%= form_with url: bulk_create_referral_admin_payouts_path, method: :post, local: true, id: "bulk-payout-form" do |f| %>
          <div class="mb-6 grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Earnings To Date</label>
              <%= f.date_field :earnings_to_date, value: Date.current, 
                  class: "w-full border border-gray-300 rounded px-3 py-2" %>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Payout Date</label>
              <%= f.date_field :payout_date, value: Date.current, 
                  class: "w-full border border-gray-300 rounded px-3 py-2" %>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
              <%= f.text_area :notes, rows: 2, 
                  class: "w-full border border-gray-300 rounded px-3 py-2" %>
            </div>
            <div class="flex items-end">
              <%= f.submit "Create Selected Payouts", 
                  class: "w-full bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 disabled:opacity-50", 
                  id: "bulk-payout-btn", disabled: true %>
            </div>
          </div>
        <% end %>
        
        <!-- Partners Table -->
        <div class="overflow-x-auto">
          <table class="min-w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left">
                  <input type="checkbox" id="select-all" class="rounded">
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Partner</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment Method</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Pending Amount</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @partners_with_pending.each do |partner| %>
                <% pending_amount = partner.total_unpaid_earnings %>
                <% next if pending_amount <= 0 %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <input type="checkbox" name="partner_ids[]" value="<%= partner.id %>" 
                           class="partner-checkbox rounded" form="bulk-payout-form">
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div>
                      <%= link_to partner.name, referral_admin_partner_path(partner), class: "text-sm font-medium text-blue-600 hover:text-blue-800 hover:underline" %>
                      <div class="text-sm text-gray-500"><%= partner.email %></div>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% if partner.account_verified? %>
                      <span class="px-2 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800">
                        <%= partner.account_type&.humanize || 'Not Set' %>
                      </span>
                    <% else %>
                      <span class="px-2 py-1 text-xs font-medium rounded-full bg-red-100 text-red-800">
                        Not Verified
                      </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="text-lg font-semibold text-green-600">
                      $<%= number_with_precision(pending_amount, precision: 2) %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                    <%= link_to "View partner", referral_admin_partner_path(partner), class: "text-blue-600 hover:text-blue-800 hover:underline" %>
                    <% if partner.account_verified? %>
                      <%= link_to "Create Payout", 
                          partner_summary_referral_admin_payouts_path(partner_id: partner.id), 
                          class: "text-green-600 hover:text-green-800" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const selectAllCheckbox = document.getElementById('select-all');
      const partnerCheckboxes = document.querySelectorAll('.partner-checkbox');
      const bulkPayoutBtn = document.getElementById('bulk-payout-btn');

      selectAllCheckbox.addEventListener('change', function() {
        partnerCheckboxes.forEach(checkbox => {
          checkbox.checked = this.checked;
        });
        updateBulkPayoutButton();
      });

      partnerCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', updateBulkPayoutButton);
      });

      function updateBulkPayoutButton() {
        const checkedBoxes = document.querySelectorAll('.partner-checkbox:checked');
        bulkPayoutBtn.disabled = checkedBoxes.length === 0;
      }
    });
  </script>
</body>
</html>
