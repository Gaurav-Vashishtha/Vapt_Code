<!DOCTYPE html>
<html>
<head>
  <title>Call Calendar</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
<div class="min-h-screen bg-gray-50">
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div>
          <h1 class="text-xl font-semibold text-gray-900">Call Calendar</h1>
          <p class="text-sm text-gray-500">
            <%= @date.strftime("%A, %d %b %Y") %> ·
            Day owner: <span class="font-medium text-gray-700"><%= @day_owner.presence || "unassigned" %></span>
          </p>
        </div>
        <div class="flex items-center gap-2">
          <%= link_to "‹ Prev", support_dashboard_call_calendar_path(date: (@date - 1)), class: "text-sm border border-gray-300 rounded-md px-3 py-2 text-gray-700 hover:bg-gray-50" %>
          <%= link_to "Today", support_dashboard_call_calendar_path, class: "text-sm border border-gray-300 rounded-md px-3 py-2 text-gray-700 hover:bg-gray-50" %>
          <%= link_to "Next ›", support_dashboard_call_calendar_path(date: (@date + 1)), class: "text-sm border border-gray-300 rounded-md px-3 py-2 text-gray-700 hover:bg-gray-50" %>
          <%= link_to "Calendar", support_dashboard_call_calendar_month_path, class: "text-sm border border-gray-300 rounded-md px-3 py-2 text-gray-700 hover:bg-gray-50" %>
        </div>
      </div>
    </div>
  </div>

  <%= render 'shared/support_navigation' %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <% if flash[:notice].present? %>
      <div class="mb-4 rounded-md bg-emerald-50 border border-emerald-200 px-4 py-2 text-sm text-emerald-800"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert].present? %>
      <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-2 text-sm text-red-800"><%= flash[:alert] %></div>
    <% end %>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
      <div class="bg-white rounded-lg p-4 border border-gray-200">
        <div class="text-2xl font-bold text-gray-900"><%= @report[:attempted] %>/<%= @report[:target] %></div>
        <div class="text-sm text-gray-500">Attempted</div>
      </div>
      <div class="bg-white rounded-lg p-4 border border-gray-200">
        <div class="text-2xl font-bold text-gray-900"><%= @report[:connect_rate] %>%</div>
        <div class="text-sm text-gray-500">Connect rate</div>
      </div>
      <div class="bg-white rounded-lg p-4 border border-gray-200">
        <div class="text-2xl font-bold text-gray-900"><%= @report[:onboarded] %></div>
        <div class="text-sm text-gray-500">Onboarded</div>
      </div>
      <div class="bg-white rounded-lg p-4 border border-gray-200">
        <div class="text-2xl font-bold text-gray-900"><%= @report[:reonboarded] %></div>
        <div class="text-sm text-gray-500">Reonboarded</div>
      </div>
      <div class="bg-white rounded-lg p-4 border border-gray-200">
        <div class="text-2xl font-bold text-gray-900"><%= @report[:reminders_due_next] %></div>
        <div class="text-sm text-gray-500">Callbacks next day</div>
      </div>
    </div>

    <div class="mb-4">
      <%= form_tag support_dashboard_call_calendar_path, method: :get, class: "flex items-center gap-2" do %>
        <%= hidden_field_tag :date, @date %>
        <%= text_field_tag :q, @query, placeholder: "Search by shop domain or phone number…", class: "flex-1 border border-gray-300 rounded px-3 py-2 text-sm" %>
        <%= submit_tag "Search", class: "text-sm bg-gray-900 text-white rounded px-4 py-2 cursor-pointer" %>
        <% if @query.present? %><%= link_to "Clear", support_dashboard_call_calendar_path(date: @date), class: "text-sm text-gray-500 hover:underline px-2" %><% end %>
      <% end %>
    </div>

    <% if @search_row %>
      <div class="mb-6 bg-white rounded-lg border-2 border-gray-300 p-4">
        <% if @search_row[:found] %>
          <%= render 'search_result', row: @search_row %>
        <% else %>
          <p class="text-sm text-gray-500">No shop found matching &ldquo;<%= @query %>&rdquo;.</p>
        <% end %>
      </div>
    <% end %>

    <% if @is_sunday %>
      <div class="bg-white rounded-lg p-8 border border-gray-200 text-center text-gray-600">
        No calling on Sundays. Pick another day or check the calendar.
      </div>
    <% elsif @todo_count.zero? && @done_count.zero? && @tab != "callbacks" && @tab != "demos" %>
      <div class="bg-white rounded-lg p-8 border border-gray-200 text-center">
        <p class="text-gray-600 mb-4">No queue has been built for today yet.</p>
        <%= form_tag call_calendar_build_path, method: :post do %>
          <%= submit_tag "Build today's queue", class: "bg-sky-600 text-white text-sm font-medium rounded-md px-4 py-2 hover:bg-sky-700 cursor-pointer" %>
        <% end %>
      </div>
    <% else %>
      <div class="flex items-center justify-between border-b border-gray-200 mb-4">
        <div class="flex items-center gap-1">
          <%= link_to support_dashboard_call_calendar_path(date: @date, tab: "todo"),
              class: "px-4 py-2 text-sm font-medium border-b-2 #{@tab == 'todo' ? 'border-sky-500 text-sky-600' : 'border-transparent text-gray-500 hover:text-gray-700'}" do %>
            Yet to be done (<%= @todo_count %>)
          <% end %>
          <%= link_to support_dashboard_call_calendar_path(date: @date, tab: "done"),
              class: "px-4 py-2 text-sm font-medium border-b-2 #{@tab == 'done' ? 'border-sky-500 text-sky-600' : 'border-transparent text-gray-500 hover:text-gray-700'}" do %>
            Done (<%= @done_count %>)
          <% end %>
          <%= link_to support_dashboard_call_calendar_path(date: @date, tab: "callbacks"),
              class: "px-4 py-2 text-sm font-medium border-b-2 #{@tab == 'callbacks' ? 'border-sky-500 text-sky-600' : 'border-transparent text-gray-500 hover:text-gray-700'}" do %>
            Scheduled callbacks (<%= @callbacks_count %>)
          <% end %>
          <%= link_to support_dashboard_call_calendar_path(date: @date, tab: "demos"),
              class: "px-4 py-2 text-sm font-medium border-b-2 #{@tab == 'demos' ? 'border-sky-500 text-sky-600' : 'border-transparent text-gray-500 hover:text-gray-700'}" do %>
            Demo scheduled (<%= @demos_count %>)
          <% end %>
          <%= link_to support_dashboard_call_calendar_path(date: @date, tab: "stats"),
              class: "px-4 py-2 text-sm font-medium border-b-2 #{@tab == 'stats' ? 'border-sky-500 text-sky-600' : 'border-transparent text-gray-500 hover:text-gray-700'}" do %>
            Stats
          <% end %>
        </div>
        <div class="flex items-center gap-2">
          <% unless @tab == "callbacks" || @tab == "demos" || @tab == "stats" %>
            <%= link_to "⬇ Download XLSX", call_calendar_export_path(date: @date, tab: @tab, page: @page), class: "mb-1 text-sm border border-gray-300 rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-50" %>
            <%= button_to "↻ Refresh queue", call_calendar_top_up_path(date: @date), method: :post, class: "mb-1 text-sm border border-gray-300 rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-50" %>
            <%= button_to "+ Get next 50", call_calendar_get_next_path(date: @date, tab: @tab, count: 50), method: :post, class: "mb-1 text-sm border border-gray-300 rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-50" %>
          <% end %>
        </div>
      </div>

      <% if @tab == "callbacks" %>
        <div class="flex items-center gap-2 mb-4">
          <%= link_to support_dashboard_call_calendar_path(date: @date, tab: "callbacks", cb_team: "support"),
              class: "text-sm rounded-full px-3 py-1 border #{@callback_team == 'support' ? 'bg-sky-600 text-white border-sky-600' : 'border-gray-300 text-gray-600 hover:bg-gray-50'}" do %>
            Support (<%= @support_callbacks_count %>)
          <% end %>
          <%= link_to support_dashboard_call_calendar_path(date: @date, tab: "callbacks", cb_team: "sales"),
              class: "text-sm rounded-full px-3 py-1 border #{@callback_team == 'sales' ? 'bg-sky-600 text-white border-sky-600' : 'border-gray-300 text-gray-600 hover:bg-gray-50'}" do %>
            Sales (<%= @sales_callbacks_count %>)
          <% end %>
        </div>

        <% if @callback_rows.empty? %>
          <div class="bg-white rounded-lg p-8 border border-gray-200 text-center text-gray-500">
            No <%= @callback_team %> callbacks scheduled.
          </div>
        <% else %>
        <div class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-100">
          <% @callback_rows.each do |row| %>
            <% reminder = row[:reminder] %>
            <details class="group">
              <summary class="flex items-center gap-4 px-4 py-3 cursor-pointer hover:bg-gray-50 list-none">
                <span class="w-28 shrink-0 text-sm <%= row[:overdue] ? "text-red-600 font-semibold" : "text-gray-700" %>">
                  <%= reminder.due_on.strftime("%d %b %Y") %>
                  <% if row[:overdue] %><span class="block text-xs text-red-500">Overdue</span><% end %>
                </span>
                <span class="flex-1 min-w-0">
                  <span class="font-medium text-gray-900 truncate block"><%= row[:display_domain] %></span>
                  <% if reminder.note.present? %><span class="block text-xs text-gray-500 truncate"><%= reminder.note %></span><% end %>
                  <span class="block text-xs text-gray-400">Set by <%= reminder.created_by.presence || "—" %></span>
                </span>
                <span class="text-sm text-gray-700 w-36 hidden md:block">
                  <% if row[:phone].present? %><a href="tel:<%= row[:phone] %>" class="text-sky-600 hover:underline" onclick="event.stopPropagation()"><%= row[:phone] %></a><% else %>—<% end %>
                </span>
              </summary>

              <%= render "row_detail",
                    crisp_url: row[:crisp_url], admin_path: row[:admin_path], store_url: row[:store_url],
                    last_contact: row[:last_contact], reminders: row[:reminders], events: row[:events],
                    domain: reminder.shopify_domain, shop_id: row[:shop_id], segment: row[:segment],
                    call_target_id: nil, cps: nil, default_team: @callback_team,
                    plan_label: row[:plan_label], plan_active: row[:plan_active], features: row[:features] %>

              <div class="px-4 pb-4 -mt-2 bg-gray-50 flex flex-wrap items-center gap-2">
                <span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-600"><%= reminder.team_label %> team</span>
                <%= form_tag call_calendar_reminder_complete_path(reminder.id, date: @date, tab: "callbacks", cb_team: @callback_team), method: :post, class: "flex flex-wrap items-center gap-2" do %>
                  <%= select_tag :outcome,
                        options_for_select([["— call outcome (optional) —", ""]] + CallRecord::OUTCOME_LABELS.map { |k, v| [v, k] }),
                        class: "text-xs border border-gray-300 rounded px-2 py-1" %>
                  <%= submit_tag "✓ Mark this callback done", class: "text-xs border border-gray-300 rounded px-3 py-1 text-gray-700 hover:bg-gray-50 cursor-pointer" %>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
        <% end %>

        <% if @has_prev || @has_more %>
          <div class="flex items-center justify-between mt-4">
            <span class="text-sm text-gray-500">
              Showing <%= @range_start %>–<%= @range_end %> of <%= @total_visible %>
            </span>
            <div class="flex items-center gap-2">
              <% if @has_prev %>
                <%= link_to "‹ Previous 75",
                    support_dashboard_call_calendar_path(date: @date, tab: @tab, cb_team: @callback_team, q: @query.presence, page: @page - 1),
                    class: "text-sm border border-gray-300 rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-50" %>
              <% end %>
              <% if @has_more %>
                <%= link_to "Next 75 ›",
                    support_dashboard_call_calendar_path(date: @date, tab: @tab, cb_team: @callback_team, q: @query.presence, page: @page + 1),
                    class: "text-sm border border-gray-300 rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-50" %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% elsif @tab == "demos" %>
        <details class="mb-4 bg-white rounded-lg border border-gray-200">
          <summary class="px-4 py-3 cursor-pointer text-sm font-medium text-sky-600 list-none">➕ New demo</summary>
          <div class="px-4 pb-4">
            <%= form_tag call_calendar_demo_path, method: :post, class: "flex flex-wrap items-end gap-2" do %>
              <label class="text-xs text-gray-600">Shop domain
                <%= text_field_tag :shopify_domain, nil, placeholder: "example.myshopify.com", class: "block mt-1 text-sm border border-gray-300 rounded px-2 py-1 min-w-[220px]" %>
              </label>
              <label class="text-xs text-gray-600">Date &amp; time
                <input type="datetime-local" name="scheduled_at" class="block mt-1 text-sm border border-gray-300 rounded px-2 py-1" />
              </label>
              <label class="text-xs text-gray-600">Owner
                <%= select_tag :owner, options_for_select([["— owner —", ""]] + @engineers.map { |e| [e, e] }), class: "block mt-1 text-sm border border-gray-300 rounded px-2 py-1" %>
              </label>
              <label class="text-xs text-gray-600 flex-1 min-w-[160px]">Notes
                <%= text_field_tag :notes, nil, placeholder: "Notes", class: "block mt-1 text-sm border border-gray-300 rounded px-2 py-1 w-full" %>
              </label>
              <%= submit_tag "Create demo", class: "text-sm bg-sky-600 text-white rounded px-4 py-1.5 cursor-pointer" %>
            <% end %>
          </div>
        </details>

        <div class="flex flex-wrap items-center gap-2 mb-4">
          <%= link_to support_dashboard_call_calendar_path(tab: "demos"),
              class: "text-sm rounded-full px-3 py-1 border #{@demo_status.nil? ? 'bg-sky-600 text-white border-sky-600' : 'border-gray-300 text-gray-600 hover:bg-gray-50'}" do %>
            All (<%= @demo_status_counts.values.sum %>)
          <% end %>
          <% @demo_status_chips.each do |st| %>
            <%= link_to support_dashboard_call_calendar_path(tab: "demos", demo_status: st),
                class: "text-sm rounded-full px-3 py-1 border #{@demo_status == st ? 'bg-sky-600 text-white border-sky-600' : 'border-gray-300 text-gray-600 hover:bg-gray-50'}" do %>
              <%= CallDemo::STATUS_LABELS[st] %> (<%= @demo_status_counts[st] || 0 %>)
            <% end %>
          <% end %>
        </div>

        <% if @demo_rows.empty? %>
          <div class="bg-white rounded-lg p-8 border border-gray-200 text-center text-gray-500">
            No demos in this view.
          </div>
        <% else %>
        <div class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-100">
          <% @demo_rows.each do |row| %>
            <% demo = row[:demo] %>
            <details class="group">
              <summary class="flex items-center gap-4 px-4 py-3 cursor-pointer hover:bg-gray-50 list-none">
                <span class="w-44 shrink-0 text-sm">
                  <span class="font-semibold text-gray-900"><%= row[:demo_time] ? row[:demo_time].strftime("%d %b %Y, %-I:%M %p") : "Time not set" %></span>
                  <span class="block text-xs text-gray-400">added <%= row[:logged_at].strftime("%d %b, %-I:%M %p") %></span>
                </span>
                <span class="flex-1 min-w-0">
                  <span class="font-medium text-gray-900 truncate block"><%= row[:display_domain] %></span>
                  <% if demo.notes.present? %><span class="block text-xs text-gray-500 truncate"><%= demo.notes %></span><% end %>
                  <span class="block text-xs text-gray-400">Owner: <%= row[:owner].presence || "—" %></span>
                </span>
                <% badge = { "scheduled" => "bg-blue-100 text-blue-700", "conducted" => "bg-emerald-100 text-emerald-700", "rescheduled" => "bg-amber-100 text-amber-800", "no_show" => "bg-red-100 text-red-700", "cancelled" => "bg-gray-100 text-gray-500", "onboarded" => "bg-emerald-100 text-emerald-700" }[row[:status]] %>
                <span class="text-xs px-2 py-0.5 rounded-full shrink-0 <%= badge %>"><%= row[:status_label] %></span>
                <span class="text-sm text-gray-700 w-36 hidden md:block">
                  <% if row[:phone].present? %><a href="tel:<%= row[:phone] %>" class="text-sky-600 hover:underline" onclick="event.stopPropagation()"><%= row[:phone] %></a><% else %>—<% end %>
                </span>
              </summary>

              <%= render "row_detail",
                    crisp_url: row[:crisp_url], admin_path: row[:admin_path], store_url: row[:store_url],
                    last_contact: row[:last_contact], reminders: row[:reminders], events: row[:events],
                    domain: demo.shopify_domain, shop_id: row[:shop_id], segment: row[:segment],
                    call_target_id: nil, cps: nil,
                    plan_label: row[:plan_label], plan_active: row[:plan_active], features: row[:features] %>

              <div class="px-4 pb-4 -mt-2 bg-gray-50">
                <p class="text-xs font-semibold text-gray-600 mb-2">Update demo</p>
                <%= form_tag call_calendar_demo_update_path(demo.id), method: :post, class: "flex flex-wrap items-center gap-2" do %>
                  <%= hidden_field_tag :demo_status, @demo_status %>
                  <%= select_tag :status, options_for_select(CallDemo::SELECTABLE_STATUSES.map { |s| [CallDemo::STATUS_LABELS[s], s] }, CallDemo::SELECTABLE_STATUSES.include?(demo.status) ? demo.status : "scheduled"), class: "text-xs border border-gray-300 rounded px-2 py-1" %>
                  <%= select_tag :owner, options_for_select([["— owner —", ""]] + @engineers.map { |e| [e, e] }, demo.owner), class: "text-xs border border-gray-300 rounded px-2 py-1" %>
                  <label class="text-xs text-gray-500">Reschedule
                    <input type="datetime-local" name="scheduled_at" class="text-xs border border-gray-300 rounded px-2 py-1" />
                  </label>
                  <%= submit_tag "Update", class: "text-xs bg-sky-600 text-white rounded px-3 py-1 cursor-pointer" %>
                <% end %>
                <p class="text-xs text-gray-400 mt-1">Picking a new date keeps the demo in the Scheduled list.</p>
              </div>
            </details>
          <% end %>
        </div>
        <% end %>

        <% if @has_prev || @has_more %>
          <div class="flex items-center justify-between mt-4">
            <span class="text-sm text-gray-500">
              Showing <%= @range_start %>–<%= @range_end %> of <%= @total_visible %>
            </span>
            <div class="flex items-center gap-2">
              <% if @has_prev %>
                <%= link_to "‹ Previous 75",
                    support_dashboard_call_calendar_path(date: @date, tab: @tab, q: @query.presence, page: @page - 1),
                    class: "text-sm border border-gray-300 rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-50" %>
              <% end %>
              <% if @has_more %>
                <%= link_to "Next 75 ›",
                    support_dashboard_call_calendar_path(date: @date, tab: @tab, q: @query.presence, page: @page + 1),
                    class: "text-sm border border-gray-300 rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-50" %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% elsif @tab == "stats" %>
        <div class="mb-4">
          <%= form_tag support_dashboard_call_calendar_path, method: :get, class: "flex flex-wrap items-end gap-2" do %>
            <%= hidden_field_tag :tab, "stats" %>
            <label class="text-xs text-gray-600">From
              <%= date_field_tag :from, @stats_from, class: "block mt-1 text-sm border border-gray-300 rounded px-2 py-1" %>
            </label>
            <label class="text-xs text-gray-600">To
              <%= date_field_tag :to, @stats_to, class: "block mt-1 text-sm border border-gray-300 rounded px-2 py-1" %>
            </label>
            <%= submit_tag "Apply", class: "text-sm bg-gray-900 text-white rounded px-4 py-1.5 cursor-pointer" %>
            <span class="text-xs text-gray-500">Showing <%= @stats[:from].strftime("%d %b %Y") %> – <%= @stats[:to].strftime("%d %b %Y") %></span>
          <% end %>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 p-4 mb-4">
          <p class="text-sm font-semibold text-gray-800 mb-3">Callbacks scheduled (<%= @stats[:callbacks_total] %>)</p>
          <div class="grid md:grid-cols-2 gap-4">
            <% @stats[:callbacks].each do |team, data| %>
              <div class="border border-gray-200 rounded-md p-3">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-sm font-medium text-gray-700"><%= team.capitalize %></span>
                  <span class="text-xs text-gray-500"><%= data[:scheduled] %> scheduled · <%= data[:done] %> done · <%= data[:open] %> open</span>
                </div>
                <% if data[:outcomes].present? %>
                  <ul class="text-xs text-gray-600 space-y-0.5">
                    <% data[:outcomes].sort_by { |_, c| -c }.each do |outcome, count| %>
                      <li class="flex justify-between"><span><%= CallRecord::OUTCOME_LABELS[outcome] || outcome %></span><span class="font-medium"><%= count %></span></li>
                    <% end %>
                  </ul>
                <% else %>
                  <p class="text-xs text-gray-400">No call outcomes recorded yet.</p>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 p-4 mb-4">
          <p class="text-sm font-semibold text-gray-800 mb-3">Demos (<%= @stats[:demos_total] %>)</p>
          <div class="flex flex-wrap gap-3">
            <% CallDemo::STATUSES.each do |st| %>
              <div class="border border-gray-200 rounded-md px-4 py-3 text-center min-w-[110px]">
                <div class="text-2xl font-bold text-gray-900"><%= @stats[:demo_status_counts][st] || 0 %></div>
                <div class="text-xs text-gray-500"><%= CallDemo::STATUS_LABELS[st] %></div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 p-4">
          <p class="text-sm font-semibold text-gray-800 mb-3">All call outcomes (<%= @stats[:calls_total] %>)</p>
          <% if @stats[:call_outcomes].present? %>
            <ul class="text-sm text-gray-600 grid md:grid-cols-2 gap-x-8 gap-y-1">
              <% @stats[:call_outcomes].sort_by { |_, c| -c }.each do |outcome, count| %>
                <li class="flex justify-between border-b border-gray-100 py-1"><span><%= CallRecord::OUTCOME_LABELS[outcome] || outcome %></span><span class="font-medium"><%= count %></span></li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-xs text-gray-400">No calls in this period.</p>
          <% end %>
        </div>
      <% else %>
      <% if @rows.empty? %>
        <div class="bg-white rounded-lg p-8 border border-gray-200 text-center text-gray-500">
          Nothing in this tab.
        </div>
      <% else %>
      <div class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-100">
        <% @rows.each do |row| %>
          <% target = row[:target] %>
          <details class="group">
            <summary class="flex items-center gap-4 px-4 py-3 cursor-pointer hover:bg-gray-50 list-none">
              <span class="text-sm font-semibold text-gray-400 w-6"><%= target.rank %></span>
              <span class="flex-1 min-w-0">
                <span class="flex items-center gap-2">
                  <span class="font-medium text-gray-900 truncate"><%= row[:display_domain] %></span>
                  <% badge = { "new_install" => "bg-blue-100 text-blue-700", "active" => "bg-emerald-100 text-emerald-700", "churned" => "bg-red-100 text-red-700" }[target.segment] %>
                  <span class="text-xs px-2 py-0.5 rounded-full <%= badge %>"><%= target.segment_label %></span>
                  <% if row[:due] %><span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">Callback due</span><% end %>
                  <% if target.status == "attempted" %><span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-600">Done</span><% end %>
                  <% if target.status == "skipped" %><span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-500">Skipped</span><% end %>
                </span>
                <span class="block text-xs text-gray-500 truncate"><%= target.reason_list.join(" · ") %></span>
              </span>
              <span class="text-sm text-gray-700 w-32 hidden md:block">
                <% if row[:phone].present? %><a href="tel:<%= row[:phone] %>" class="text-sky-600 hover:underline"><%= row[:phone] %></a><% else %>—<% end %>
              </span>
              <span class="text-right w-20">
                <span class="text-sm font-semibold text-gray-900"><%= target.cps %></span>
                <span class="block text-xs text-gray-400">V<%= target.value_score %>/U<%= target.urgency_score %></span>
              </span>
            </summary>

            <%= render "row_detail",
                  crisp_url: row[:crisp_url], admin_path: row[:admin_path], store_url: row[:store_url],
                  last_contact: row[:last_contact], reminders: row[:reminders], events: row[:events],
                  domain: target.shopify_domain, shop_id: target.shop_id, segment: target.segment,
                  call_target_id: target.id, cps: target.cps,
                  plan_label: row[:plan_label], plan_active: row[:plan_active], features: row[:features] %>
          </details>
        <% end %>
      </div>

      <% if @has_prev || @has_more %>
        <div class="flex items-center justify-between mt-4">
          <span class="text-sm text-gray-500">
            Showing <%= @range_start %>–<%= @range_end %> of <%= @total_visible %>
          </span>
          <div class="flex items-center gap-2">
            <% if @has_prev %>
              <%= link_to "‹ Previous 75",
                  support_dashboard_call_calendar_path(date: @date, tab: @tab, q: @query.presence, page: @page - 1),
                  class: "text-sm border border-gray-300 rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-50" %>
            <% end %>
            <% if @has_more %>
              <%= link_to "Next 75 ›",
                  support_dashboard_call_calendar_path(date: @date, tab: @tab, q: @query.presence, page: @page + 1),
                  class: "text-sm border border-gray-300 rounded-md px-3 py-1.5 text-gray-700 hover:bg-gray-50" %>
            <% end %>
          </div>
        </div>
      <% end %>
      <% end %>
      <% end %>
    <% end %>
  </div>
</div>
</body>
</html>
