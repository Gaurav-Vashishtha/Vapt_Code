<% if notice.present? %><div class="mb-4 rounded-md bg-green-50 border border-green-200 text-green-800 px-4 py-3 text-sm"><%= notice %></div><% end %>
<% if alert.present? %><div class="mb-4 rounded-md bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm break-words"><%= alert %></div><% end %>
