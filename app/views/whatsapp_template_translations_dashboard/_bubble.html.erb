<%# WhatsApp-style preview of template components. Locals: components, rtl %>
<%
  comps = Whatsapp::TemplateComponents.normalize(components)
  header = comps.find { |c| c["type"] == "HEADER" }
  body = comps.find { |c| c["type"] == "BODY" }
  footer = comps.find { |c| c["type"] == "FOOTER" }
  buttons = Whatsapp::TemplateComponents.buttons(comps)
  fill = lambda do |text|
    h(text.to_s).gsub(Whatsapp::TemplateComponents::PLACEHOLDER) { %(<span class="bg-yellow-100 text-yellow-900 rounded px-1">{{#{$1}}}</span>) }.gsub("\n", "<br>").html_safe
  end
%>
<div class="bg-[#e5ddd5] rounded-lg p-4">
  <div class="bg-white rounded-lg shadow-sm max-w-sm <%= rtl ? 'ml-auto' : '' %>" dir="<%= rtl ? 'rtl' : 'ltr' %>">
    <% if header %>
      <% if header["format"].to_s.in?(%w[IMAGE VIDEO DOCUMENT]) %>
        <div class="bg-gray-200 text-gray-500 text-xs text-center rounded-t-lg py-8"><%= header["format"].capitalize %> header</div>
      <% elsif header["text"].present? %>
        <div class="px-3 pt-3 font-semibold text-sm"><%= fill.call(header["text"]) %></div>
      <% end %>
    <% end %>
    <div class="px-3 py-2 text-sm text-gray-900 leading-relaxed"><%= body ? fill.call(body["text"]) : content_tag(:span, "(no body)", class: "text-gray-400") %></div>
    <% if footer && footer["text"].present? %>
      <div class="px-3 pb-2 text-xs text-gray-500"><%= fill.call(footer["text"]) %></div>
    <% end %>
    <% buttons.each do |b| %>
      <div class="border-t border-gray-100 text-center text-sm text-[#00a5f4] py-2"><%= b["text"].presence || b["type"] %></div>
    <% end %>
  </div>
</div>
