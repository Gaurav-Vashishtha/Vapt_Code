<!DOCTYPE html>
<html>
<head>
  <title>Support Dashboard - <%= @translation.template_name %> (<%= WhatsappTemplateTranslation.language_name(@translation.language) %>)</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
<%
  t = @translation
  rtl = WhatsappTemplateTranslation.rtl?(t.language)
  label_for = ->(id) { id.start_with?('button_') ? "Button #{id.split('_').last.to_i + 1}" : id.capitalize }
  limit_for = ->(id) { id.start_with?('button_') ? 25 : Whatsapp::TemplateComponents::LIMITS[id.upcase] }
%>
<div class="bg-white border-b border-gray-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div>
      <h1 class="text-xl font-semibold text-gray-900 font-mono"><%= t.template_name %></h1>
      <p class="text-xs text-gray-500"><%= WhatsappTemplateTranslation.language_name(t.language) %> · <%= t.category || 'UTILITY' %> · status <b><%= t.status %></b><%= " · drafted by #{t.drafted_by}" if t.drafted_by %><%= " · submitted by #{t.submitted_by} #{t.submitted_at&.strftime('%d %b %H:%M')}" if t.submitted_by %></p>
    </div>
    <%= link_to '← All templates', support_dashboard_whatsapp_languages_path, class: 'text-sm text-blue-600 hover:underline' %>
  </div>
</div>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
  <%= render 'flash' %>

  <% if t.rejection_reason.present? && t.status.in?(%w[rejected failed]) %>
    <div class="rounded-md bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm"><b><%= t.status.capitalize %>:</b> <%= t.rejection_reason %>
      <% if t.status == 'rejected' %><br><span class="text-xs">If MSG91 refuses a resubmission under the same name, edit or delete this language version in the MSG91 panel first.</span><% end %>
    </div>
  <% end %>

  <% if t.category.to_s.casecmp?('AUTHENTICATION') %>
    <div class="rounded-md bg-blue-50 border border-blue-200 text-blue-900 px-4 py-3 text-sm">This is an Authentication (OTP) template. Meta writes the wording for these itself: submitting adds <b><%= WhatsappTemplateTranslation.language_name(t.language) %></b> to the template and Meta fills in its own standard <%= WhatsappTemplateTranslation.language_name(t.language) %> text (code, security note, copy-code button). The translation below is for reference only and isn't sent.</div>
  <% end %>

  <% if @errors.any? %>
    <div class="rounded-md bg-yellow-50 border border-yellow-200 text-yellow-900 px-4 py-3 text-sm">
      <b>Fix before submitting:</b>
      <ul class="list-disc ml-5 mt-1"><% @errors.each do |e| %><li><%= e %></li><% end %></ul>
    </div>
  <% end %>

  <div class="grid md:grid-cols-2 gap-6">
    <div>
      <h2 class="text-sm font-medium text-gray-700 mb-2">English (approved source)</h2>
      <%= render 'bubble', components: t.source_components, rtl: false %>
    </div>
    <div>
      <h2 class="text-sm font-medium text-gray-700 mb-2"><%= WhatsappTemplateTranslation.language_name(t.language) %> preview</h2>
      <% if t.components.present? %>
        <%= render 'bubble', components: t.components, rtl: rtl %>
      <% else %>
        <div class="rounded-lg border border-dashed border-gray-300 p-8 text-center text-sm text-gray-500">No translation yet.</div>
      <% end %>
    </div>
  </div>

  <section class="bg-white shadow rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-medium text-gray-900">Translation</h2>
        <p class="text-sm text-gray-500">Keep every <code>{{1}}</code>-style variable. URLs, button types and the media header are copied from English automatically.</p>
      </div>
      <% if t.editable? && ENV['ANTHROPIC_API_KEY'].present? %>
        <%= button_to (t.components.present? ? 'Redraft with AI' : 'Draft with AI'), support_dashboard_whatsapp_language_draft_path(t),
                      class: 'px-3 py-2 text-sm rounded-md border border-blue-300 text-blue-700 hover:bg-blue-50',
                      form: (t.components.present? ? { onsubmit: "return confirm('Replace the current text with a new AI draft?')" } : {}) %>
      <% end %>
    </div>

    <% if @strings.empty? %>
      <p class="px-6 py-6 text-sm text-gray-500">The English source has no text — fetch from MSG91 first.</p>
    <% else %>
      <%= form_with url: support_dashboard_whatsapp_language_path(t), method: :patch, local: true, class: 'px-6 py-4 space-y-5' do %>
        <% @strings.each do |s| %>
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1"><%= label_for.call(s['id']) %> · English</div>
              <div class="text-sm text-gray-800 bg-gray-50 rounded-md p-3 whitespace-pre-wrap"><%= s['text'] %></div>
            </div>
            <div>
              <div class="text-xs font-medium text-gray-500 uppercase mb-1"><%= label_for.call(s['id']) %> · <%= WhatsappTemplateTranslation.language_name(t.language) %><%= " (max #{limit_for.call(s['id'])})" if limit_for.call(s['id']) %></div>
              <textarea name="texts[<%= s['id'] %>]" dir="<%= rtl ? 'rtl' : 'ltr' %>" rows="<%= s['id'] == 'body' ? 6 : 2 %>" <%= 'disabled' unless t.editable? %>
                        class="w-full rounded-md border border-gray-300 p-3 text-sm <%= 'bg-gray-100' unless t.editable? %>"><%= @current_text[s['id']] %></textarea>
            </div>
          </div>
        <% end %>
        <% if t.editable? %>
          <button class="px-4 py-2 text-sm rounded-md bg-gray-900 text-white hover:bg-gray-700">Save draft</button>
        <% end %>
      <% end %>
    <% end %>
  </section>

  <% if t.editable? && t.components.present? %>
    <section class="bg-white shadow rounded-lg px-6 py-4">
      <h2 class="text-lg font-medium text-gray-900">Submit for Meta review</h2>
      <p class="text-sm text-gray-500 mb-3">Goes to MSG91 as <code><%= t.template_name %></code> in <code><%= t.language %></code>. Approval usually takes minutes to a day; status refreshes every 30 minutes.</p>
      <%= form_with url: support_dashboard_whatsapp_language_submit_path(t), method: :post, local: true, class: 'flex flex-wrap items-end gap-3' do %>
        <label class="text-sm">Reviewed by
          <input name="reviewer" required placeholder="Your name" class="mt-1 block rounded-md border border-gray-300 px-2 py-1.5">
        </label>
        <label class="text-sm flex items-center gap-2"><input type="checkbox" required> I read the whole translation and it is correct</label>
        <button class="px-4 py-2 text-sm rounded-md bg-green-600 text-white hover:bg-green-700 disabled:opacity-50" <%= 'disabled' if @errors.any? %>>Submit to Meta</button>
      <% end %>
    </section>
  <% end %>
</div>
</body>
</html>
