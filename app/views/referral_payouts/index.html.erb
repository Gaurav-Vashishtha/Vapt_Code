<!-- CREATE NEW FILE: app/views/referral_payouts/index.html.erb -->
<!DOCTYPE html>
<html>
<head>
  <title>Payouts - Referral Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-100">
  <%= render 'layouts/referral_navigation' %>
  
  <div class="container mx-auto px-4 py-8">
    <!-- Flash Messages -->
    <% if flash[:notice] %>
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
        <%= flash[:notice] %>
      </div>
    <% end %>
    
    <% if flash[:alert] %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-gray-800">Payouts</h1>
      <div class="flex space-x-3">
        
        <%= link_to "Dashboard", referral_dashboard_path, 
            class: "bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700" %>
      </div>
    </div>
    
    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-700">Pending Earnings</h3>
        <p class="text-3xl font-bold text-orange-600">
          $<%= number_with_precision((@payout_summary && @payout_summary[:total_pending]) || 0, precision: 2) %>
        </p>
        <% if @payout_summary && @payout_summary[:next_payout_eligible] %>
          <% if @payout_summary[:next_payout_eligible][:eligible] %>
            <small class="text-green-600">✓ Eligible for payout</small>
          <% else %>
            <small class="text-gray-500">
              Need $<%= number_with_precision(@payout_summary[:next_payout_eligible][:minimum_required] - @payout_summary[:next_payout_eligible][:amount], precision: 2) %> more
            </small>
          <% end %>
        <% end %>
      </div>
      
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-700">Total Paid</h3>
        <p class="text-3xl font-bold text-green-600">
          $<%= number_with_precision((@payout_summary && @payout_summary[:total_paid]) || 0, precision: 2) %>
        </p>
        <small class="text-gray-500">Lifetime earnings paid</small>
      </div>
      
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-700">Last Payout</h3>
        <% if @payout_summary && @payout_summary[:last_payout] %>
          <p class="text-2xl font-bold text-blue-600">
            $<%= number_with_precision(@payout_summary[:last_payout].total_amount, precision: 2) %>
          </p>
          <small class="text-gray-500"><%= @payout_summary[:last_payout].payout_date.strftime('%b %d, %Y') %></small>
        <% else %>
          <p class="text-xl text-gray-500">No payouts yet</p>
        <% end %>
      </div>
      
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-700">Next Payout</h3>
        <% if @payout_summary && @payout_summary[:next_payout_eligible] && @payout_summary[:next_payout_eligible][:estimated_payout_date] %>
          <p class="text-xl font-bold text-purple-600">
            <%= @payout_summary[:next_payout_eligible][:estimated_payout_date].strftime('%b %d, %Y') %>
          </p>
          <small class="text-gray-500">Estimated date</small>
        <% else %>
          <p class="text-xl text-gray-500">TBD</p>
          <small class="text-gray-500">Need minimum earnings</small>
        <% end %>
      </div>
    </div>

    <!-- Account Verification Alert -->
    <% if @partner && !@partner.account_verified? %>
      <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-6">
        <div class="flex items-center">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
          </svg>
          <div>
            <strong>Account verification required</strong> - Please complete your payment details to receive payouts.
            <%= link_to "Update Account Details", edit_referral_account_details_path, 
                class: "underline font-semibold hover:text-yellow-900" %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Payout Eligibility Banner -->
    <% if @payout_summary && @payout_summary[:next_payout_eligible] && @payout_summary[:next_payout_eligible][:eligible] %>
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <div>
              <strong>Payout Ready!</strong> You have $<%= number_with_precision(@payout_summary[:total_pending], precision: 2) %> eligible for payout.
              <% if @payout_summary[:next_payout_eligible][:estimated_payout_date] %>
                Expected payout date: <%= @payout_summary[:next_payout_eligible][:estimated_payout_date].strftime('%B %d, %Y') %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Monthly Payout Chart -->
    <% if @monthly_payouts && @monthly_payouts.any? %>
      <div class="bg-white rounded-lg shadow p-6 mb-8">
        <h3 class="text-xl font-bold text-gray-800 mb-4">Monthly Payout History</h3>
        <div class="h-64">
          <canvas id="payoutChart"></canvas>
        </div>
      </div>
    <% end %>

    <!-- Payout History Table -->
    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b">
        <h3 class="text-xl font-bold text-gray-800">Payout History</h3>
      </div>
      
      <% if @payouts && @payouts.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payout Date</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment Method</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Earnings Period</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @payouts.each do |payout| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% if payout.payout_date %>
                      <%= payout.payout_date.strftime('%b %d, %Y') %>
                    <% else %>
                      N/A
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="text-lg font-semibold text-green-600">
                      $<%= number_with_precision(payout.total_amount || 0, precision: 2) %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 py-1 text-xs font-semibold rounded-full 
                      <%= case payout.status&.to_s
                          when 'pending' then 'bg-yellow-100 text-yellow-800'
                          when 'processing' then 'bg-blue-100 text-blue-800'
                          when 'completed' then 'bg-green-100 text-green-800'
                          when 'failed', 'cancelled' then 'bg-red-100 text-red-800'
                          else 'bg-gray-100 text-gray-800'
                          end %>">
                      <%= payout.status&.humanize || 'Unknown' %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <%= payout.payment_method&.humanize || 'Unknown' %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <% if payout.earnings_from_date && payout.earnings_to_date %>
                      <%= payout.earnings_from_date.strftime('%m/%d') %> - 
                      <%= payout.earnings_to_date.strftime('%m/%d/%Y') %>
                    <% else %>
                      N/A
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <%= link_to "View Details", referral_payout_path(payout), 
                        class: "text-blue-600 hover:text-blue-800 font-medium" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-12">
          <svg class="w-12 h-12 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
          </svg>
          <h3 class="text-lg font-medium text-gray-900 mb-2">No payouts yet</h3>
          <p class="text-gray-500 mb-4">Once you start earning commissions, payouts will appear here.</p>
          <%= link_to "View Earnings", referral_earnings_path, 
              class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Chart Script -->
  <% if @monthly_payouts && @monthly_payouts.any? %>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('payoutChart').getContext('2d');
        
        const data = {
          labels: [<%= @monthly_payouts.map { |date, amount| "'#{date.strftime('%b %Y')}'" }.join(', ').html_safe %>],
          datasets: [{
            label: 'Monthly Payouts',
            data: [<%= @monthly_payouts.map { |date, amount| amount }.join(', ') %>],
            backgroundColor: 'rgba(34, 197, 94, 0.2)',
            borderColor: 'rgba(34, 197, 94, 1)',
            borderWidth: 2,
            fill: true,
            tension: 0.4
          }]
        };

        const config = {
          type: 'line',
          data: data,
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                display: false
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: function(value, index, values) {
                    return '$' + value.toLocaleString();
                  }
                }
              }
            }
          }
        };

        new Chart(ctx, config);
      });
    </script>
  <% end %>
</body>
</html>