<!-- app/views/callback_mailer/acknowledgment.html.erb -->
<!DOCTYPE html>
<html>
<head>
  <style>
    .header { 
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 30px;
      text-align: center;
      border-radius: 8px 8px 0 0;
    }
    .content { 
      padding: 30px;
      background: white;
      border: 1px solid #e5e5e5;
      border-radius: 0 0 8px 8px;
    }
    .details {
      background: #f9f9f9;
      padding: 20px;
      border-radius: 8px;
      margin: 20px 0;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>Callback Request Received</h1>
  </div>
  
  <div class="content">
    <p>Hi <%= @callback_request.name %>,</p>
    
    <p>Thank you for requesting a callback. We've received your request and our team will get back to you soon.</p>
    
    <div class="details">
      <h3>Your Request Details:</h3>
      <p><strong>Preferred Time:</strong> <%= @callback_request.preferred_time %> (<%= @callback_request.timezone %>)</p>
      <p><strong>Contact Number:</strong> <%= @callback_request.phone_number %></p>
      <% if @callback_request.notes.present? %>
        <p><strong>Your Message:</strong></p>
        <p style="padding: 10px; background: white; border-radius: 4px;">
          <%= simple_format(@callback_request.notes) %>
        </p>
      <% end %>
    </div>
    
    <p>While we'll try to call during your preferred time, please note that the exact timing cannot be guaranteed. Our team typically responds within 24-48 hours.</p>
    
    <p>Best regards,<br>
    The Cod King Support Team</p>
  </div>
</body>
</html>