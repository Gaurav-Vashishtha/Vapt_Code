<!-- app/views/callback_mailer/notify_approvers.html.erb -->
<!DOCTYPE html>
<html>
<head>
  <style>
    .callback-details { 
      background: #f5f5f5; 
      padding: 20px; 
      border-radius: 8px; 
      margin: 20px 0;
    }
    .field { 
      margin: 10px 0; 
      padding: 10px;
      background: white;
      border-radius: 4px;
    }
    .label { 
      font-weight: bold; 
      color: #333;
      margin-right: 10px;
    }
    .urgent {
      background: #fff3cd;
      border-left: 4px solid #ffc107;
      padding: 10px;
      margin: 10px 0;
    }
  </style>
</head>
<body>
  <h2>New Callback Request</h2>
  
  <div class="urgent">
    <strong>⚠️ Action Required:</strong> New callback request from merchant
  </div>
  
  <div class="callback-details">
    <div class="field">
      <span class="label">Shop:</span> <%= @callback_request.shop_domain %>
    </div>
    
    <div class="field">
      <span class="label">Name:</span> <%= @callback_request.name %>
    </div>
    
    <div class="field">
      <span class="label">Phone:</span> <%= @callback_request.phone_number %>
    </div>
    
    <div class="field">
      <span class="label">Email:</span> 
      <a href="mailto:<%= @callback_request.email %>"><%= @callback_request.email %></a>
    </div>
    
    <div class="field">
      <span class="label">Preferred Time:</span> 
      <%= @callback_request.preferred_time %> (<%= @callback_request.timezone %>)
    </div>
    
    <div class="field">
      <span class="label">Notes:</span>
      <div style="margin-top: 5px; padding: 10px; background: #fafafa; border-radius: 4px;">
        <%= simple_format(@callback_request.notes) %>
      </div>
    </div>
    
    <div class="field">
      <span class="label">Requested At:</span> 
      <%= @callback_request.created_at.strftime("%B %d, %Y at %I:%M %p UTC") %>
    </div>
  </div>
  
  <p style="color: #666; font-size: 14px;">
    Please reach out to the merchant at your earliest convenience.
  </p>
</body>
</html>