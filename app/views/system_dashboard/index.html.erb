<% content_for :title, "System Dashboard" %>

<div class="dashboard-container">
  <div class="dashboard-header">
    <h1 class="dashboard-title">System Analytics Dashboard</h1>
    
    <!-- Time Range Filter -->
    <div class="time-filter">
      <%= form_with url: system_dashboard_path, method: :get, local: true, class: "time-filter-form" do |form| %>
        <%= form.select :time_range, 
            options_for_select([
              ['Last 6 Hours', '6_hours'],
              ['Last 24 Hours', '24_hours'],
              ['Last 72 Hours', '72_hours'],
              ['Last 7 Days', '7_days'],
              ['Last 30 Days', '30_days']
            ], @time_range),
            {},
            { class: "time-select", onchange: "this.form.submit();" } %>
      <% end %>
    </div>
  </div>

  <!-- Main Metrics Grid -->
  <div class="metrics-grid">
    <!-- Total Shops Widget -->
    <div class="metric-card primary">
      <div class="metric-header">
        <h3>Total Shops</h3>
        <div class="metric-icon">🏪</div>
      </div>
      <div class="metric-value"><%= number_with_delimiter(@total_shops) %></div>
      <div class="metric-subtitle">
        <span class="metric-change positive">+<%= @shops_in_range %></span>
        in selected period
      </div>
    </div>

    <!-- Order Confirmations Widget -->
    <div class="metric-card info">
      <div class="metric-header">
        <h3>Order Confirmations</h3>
        <div class="metric-icon">📦</div>
      </div>
      <div class="metric-value"><%= number_with_delimiter(@total_order_confirmations) %></div>
      <div class="metric-subtitle">
        <span class="metric-change">+<%= @order_confirmations_in_range %></span>
        in selected period
      </div>
    </div>

    <!-- Pre-Order OTP Verification Widget -->
    <div class="metric-card purple">
      <div class="metric-header">
        <h3>OTP Verification</h3>
        <div class="metric-icon">🔐</div>
      </div>
      <div class="metric-value"><%= number_with_delimiter(@otp_verified) %></div>
      <div class="metric-subtitle">
        <span class="metric-change">+<%= @otp_verified_in_range %></span>
        verified in period
      </div>
      <div class="metric-extra">
        Verification Rate: <strong><%= @otp_verification_rate %>%</strong>
      </div>
    </div>

    <!-- COD Partial Payment Widget -->
    <div class="metric-card gold">
      <div class="metric-header">
        <h3>COD Partial Payments</h3>
        <div class="metric-icon">💰</div>
      </div>
      <div class="metric-value"><%= number_with_delimiter(@cod_partial_payment_count) %></div>
      <div class="metric-subtitle">
        Total Value: ₹<%= number_with_delimiter(@cod_partial_payment_value) %>
      </div>
      <div class="metric-extra">
        Avg Order: <strong>₹<%= @average_partial_payment_value %></strong>
      </div>
    </div>
  </div>

  <!-- Enhanced Metrics Grid -->
  <div class="enhanced-metrics">
    <!-- Abandoned Cart Recovery -->
    <div class="metric-section">
      <h2>🛒 Abandoned Cart Recovery</h2>
      <div class="metrics-row">
        <div class="metric-card-small recovery">
          <h4>Recovered Carts</h4>
          <div class="metric-big"><%= @abandoned_recovered_count %></div>
          <div class="metric-small">Recovery Rate: <%= @abandonment_recovery_rate %>%</div>
        </div>
        <div class="metric-card-small recovery">
          <h4>Recovery Sales</h4>
          <div class="metric-big">₹<%= number_with_delimiter(@abandoned_sales) %></div>
          <div class="metric-small">Avg Order: ₹<%= @average_recovered_order_value %></div>
        </div>
        <div class="metric-card-small recovery">
          <h4>Total Abandoned</h4>
          <div class="metric-big"><%= @abandoned_carts_in_range %></div>
          <div class="metric-small">in selected period</div>
        </div>
      </div>
    </div>

    <!-- Twilio Logs Breakdown -->
    <div class="metric-section">
      <h2>📞 Twilio Communication Breakdown</h2>
      <div class="breakdown-grid">
        <% if @twilio_breakdown.present? %>
          <% @twilio_breakdown.each do |ver_type, count| %>
            <div class="breakdown-card">
              <h4><%= ver_type.present? ? ver_type.humanize : 'No Type' %></h4>
              <div class="breakdown-value"><%= count %></div>
              <div class="breakdown-percentage">
                <%= @twilio_breakdown_percentages[ver_type] %>%
              </div>
            </div>
          <% end %>
        <% end %>
        <div class="breakdown-card total">
          <h4>Total Logs</h4>
          <div class="breakdown-value"><%= @twilio_logs_in_range %></div>
          <div class="breakdown-percentage">100%</div>
        </div>
      </div>
    </div>

    <!-- Order Status Breakdown -->
    <div class="metric-section">
      <h2>📋 Order Confirmation Status</h2>
      <div class="status-grid">
        <% if @order_confirmation_breakdown.present? %>
          <% @order_confirmation_breakdown.each do |status, count| %>
            <div class="status-card">
              <h4><%= status.present? ? status.humanize : 'No Status' %></h4>
              <div class="status-value"><%= count %></div>
              <div class="status-percentage">
                <%= @order_status_percentages[status] %>%
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="status-card">
            <h4>No Data</h4>
            <div class="status-value">0</div>
            <div class="status-percentage">0%</div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- COD-Prepaid Status Breakdown -->
    <div class="metric-section">
      <h2>💳 COD-Prepaid Status Breakdown</h2>
      <div class="prepaid-grid">
        <% if @cod_prepaid_breakdown.present? %>
          <% @cod_prepaid_breakdown.each do |status, count| %>
            <div class="prepaid-card">
              <h4><%= status.humanize %></h4>
              <div class="prepaid-value"><%= count %></div>
              <div class="prepaid-percentage">
                <%= @cod_prepaid_percentages[status] %>%
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="prepaid-card empty">
            <h4>No COD-Prepaid Orders</h4>
            <div class="prepaid-value">0</div>
            <div class="prepaid-percentage">0%</div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Feature Adoption Section -->
  <div class="feature-adoption">
    <h2>Feature Adoption</h2>
    <div class="adoption-grid">
      <div class="adoption-card">
        <h4>COD Fee Enabled</h4>
        <div class="adoption-value"><%= number_with_delimiter(@shops_with_cod_enabled) %></div>
        <div class="adoption-percentage">
          <%= @cod_adoption_percentage %>% of shops
        </div>
      </div>
      
      <div class="adoption-card">
        <h4>Prepaid Enabled</h4>
        <div class="adoption-value"><%= number_with_delimiter(@shops_with_prepaid_enabled) %></div>
        <div class="adoption-percentage">
          <%= @prepaid_adoption_percentage %>% of shops
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.dashboard-container {
  padding: 20px;
  max-width: 1200px;
  margin: 0 auto;
}

.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
  padding-bottom: 20px;
  border-bottom: 2px solid #e9ecef;
}

.dashboard-title {
  font-size: 2.5rem;
  font-weight: 700;
  color: #2c3e50;
  margin: 0;
}

.time-filter-form {
  display: flex;
  align-items: center;
  gap: 10px;
}

.time-select {
  padding: 8px 16px;
  border: 2px solid #ddd;
  border-radius: 8px;
  font-size: 14px;
  background: white;
  cursor: pointer;
  transition: border-color 0.3s ease;
}

.time-select:hover {
  border-color: #007bff;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
  margin-bottom: 40px;
}

.metric-card {
  background: white;
  border-radius: 12px;
  padding: 24px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  border-left: 4px solid;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.metric-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
}

.metric-card.primary { border-left-color: #007bff; }
.metric-card.info { border-left-color: #17a2b8; }
.metric-card.purple { border-left-color: #6f42c1; }
.metric-card.gold { border-left-color: #fd7e14; }

.metric-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.metric-header h3 {
  margin: 0;
  font-size: 16px;
  color: #6c757d;
  font-weight: 600;
}

.metric-icon {
  font-size: 24px;
}

.metric-value {
  font-size: 2.5rem;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 8px;
}

.metric-subtitle {
  font-size: 14px;
  color: #6c757d;
}

.metric-change {
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 12px;
}

.metric-change.positive {
  background: #d4edda;
  color: #155724;
}

.metric-extra {
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid #e9ecef;
  font-size: 13px;
  color: #6c757d;
}

.enhanced-metrics {
  margin-top: 40px;
}

.metric-section {
  background: white;
  border-radius: 12px;
  padding: 24px;
  margin-bottom: 30px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
}

.metric-section h2 {
  margin-top: 0;
  margin-bottom: 20px;
  color: #2c3e50;
  font-size: 1.3rem;
  border-bottom: 2px solid #e9ecef;
  padding-bottom: 10px;
}

.metrics-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
}

.metric-card-small {
  background: #f8f9fa;
  padding: 16px;
  border-radius: 8px;
  text-align: center;
  border-left: 4px solid #28a745;
}

.metric-card-small h4 {
  margin: 0 0 8px 0;
  color: #495057;
  font-size: 13px;
  font-weight: 600;
}

.metric-big {
  font-size: 1.8rem;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 4px;
}

.metric-small {
  font-size: 11px;
  color: #6c757d;
}

.breakdown-grid, .status-grid, .prepaid-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 15px;
}

.breakdown-card, .status-card, .prepaid-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 16px;
  border-radius: 8px;
  text-align: center;
  transition: transform 0.3s ease;
}

.breakdown-card:hover, .status-card:hover, .prepaid-card:hover {
  transform: translateY(-2px);
}

.breakdown-card.total {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.prepaid-card.empty {
  background: linear-gradient(135deg, #d299c2 0%, #fef9d7 100%);
}

.breakdown-card h4, .status-card h4, .prepaid-card h4 {
  margin: 0 0 8px 0;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
}

.breakdown-value, .status-value, .prepaid-value {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 4px;
}

.breakdown-percentage, .status-percentage, .prepaid-percentage {
  font-size: 10px;
  opacity: 0.8;
}

.feature-adoption {
  background: white;
  border-radius: 12px;
  padding: 24px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
}

.feature-adoption h2 {
  margin-top: 0;
  margin-bottom: 20px;
  color: #2c3e50;
  font-size: 1.5rem;
}

.adoption-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
}

.adoption-card {
  background: #f8f9fa;
  padding: 20px;
  border-radius: 8px;
  text-align: center;
}

.adoption-card h4 {
  margin: 0 0 12px 0;
  color: #495057;
  font-size: 14px;
  font-weight: 600;
}

.adoption-value {
  font-size: 1.8rem;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 8px;
}

.adoption-percentage {
  font-size: 12px;
  color: #6c757d;
}

@media (max-width: 768px) {
  .dashboard-header {
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }
  
  .metrics-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
// Auto-refresh every 5 minutes
setTimeout(function() {
  location.reload();
}, 300000);
</script>