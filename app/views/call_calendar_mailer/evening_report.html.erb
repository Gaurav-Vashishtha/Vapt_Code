<div style="font-family: -apple-system, Segoe UI, Roboto, sans-serif; color: #111; max-width: 760px;">
  <h2 style="margin-bottom: 4px;">Call report — <%= @date.strftime("%A, %d %b %Y") %></h2>
  <p style="color: #555; margin-top: 0;">Day owner: <strong><%= @report[:day_owner].presence || "unassigned" %></strong></p>

  <table style="border-collapse: collapse; margin: 12px 0;">
    <tr>
      <td style="padding: 8px 16px 8px 0;"><div style="font-size: 22px; font-weight: 700;"><%= @report[:attempted] %>/<%= @report[:target] %></div><div style="color:#777; font-size:12px;">Attempted</div></td>
      <td style="padding: 8px 16px;"><div style="font-size: 22px; font-weight: 700;"><%= @report[:connect_rate] %>%</div><div style="color:#777; font-size:12px;">Connect rate</div></td>
      <td style="padding: 8px 16px;"><div style="font-size: 22px; font-weight: 700;"><%= @report[:onboarded] %></div><div style="color:#777; font-size:12px;">Onboarded</div></td>
      <td style="padding: 8px 16px;"><div style="font-size: 22px; font-weight: 700;"><%= @report[:reonboarded] %></div><div style="color:#777; font-size:12px;">Reonboarded</div></td>
      <td style="padding: 8px 16px;"><div style="font-size: 22px; font-weight: 700;"><%= @report[:reminders_due_next] %></div><div style="color:#777; font-size:12px;">Callbacks next day</div></td>
    </tr>
  </table>

  <h3 style="margin-bottom: 6px;">Outcomes</h3>
  <% if @report[:outcomes].empty? %>
    <p style="color:#777;">No calls logged today.</p>
  <% else %>
    <table style="border-collapse: collapse; font-size: 13px;">
      <% @report[:outcomes].each do |label, count| %>
        <tr style="border-bottom: 1px solid #eee;">
          <td style="padding: 4px 16px 4px 0;"><%= label %></td>
          <td style="padding: 4px 0; text-align: right;"><strong><%= count %></strong></td>
        </tr>
      <% end %>
    </table>
  <% end %>

  <% if @report[:per_agent].present? %>
    <h3 style="margin-bottom: 6px;">By engineer</h3>
    <table style="border-collapse: collapse; font-size: 13px;">
      <% @report[:per_agent].sort_by { |_, v| -v }.each do |agent, count| %>
        <tr style="border-bottom: 1px solid #eee;">
          <td style="padding: 4px 16px 4px 0;"><%= agent %></td>
          <td style="padding: 4px 0; text-align: right;"><strong><%= count %></strong></td>
        </tr>
      <% end %>
    </table>
  <% end %>

  <% if @report[:not_reached].present? %>
    <h3 style="margin-bottom: 6px;">High-value not reached</h3>
    <table style="border-collapse: collapse; width: 100%; font-size: 13px;">
      <thead>
        <tr style="background:#f3f4f6; text-align:left;">
          <th style="padding: 6px 8px;">Shop</th>
          <th style="padding: 6px 8px;">Segment</th>
          <th style="padding: 6px 8px;">Phone</th>
          <th style="padding: 6px 8px;">CPS</th>
        </tr>
      </thead>
      <tbody>
        <% @report[:not_reached].each do |target| %>
          <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 6px 8px;"><%= target.shopify_domain %></td>
            <td style="padding: 6px 8px;"><%= target.segment_label %></td>
            <td style="padding: 6px 8px;"><%= target.contact_phone.presence || "—" %></td>
            <td style="padding: 6px 8px;"><%= target.cps %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
