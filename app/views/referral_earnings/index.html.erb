<!-- CREATE NEW FILE: app/views/referral_earnings/index.html.erb -->

<!DOCTYPE html>
<html>
<head>
  <title>Earnings - Referral Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <%= render 'layouts/referral_navigation' %>
  
  <div class="container mx-auto px-4 py-8">
    <!-- Flash Messages -->
    <% if flash[:notice] %>
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
        <%= flash[:notice] %>
      </div>
    <% end %>
    
    <% if flash[:alert] %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-gray-800">Earnings</h1>
      <div class="flex space-x-3">
        <%= link_to "View Payouts", referral_payouts_path, 
            class: "bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
        <%= link_to "Dashboard", referral_dashboard_path, 
            class: "bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700" %>
      </div>
    </div>
    
    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-700">Unpaid Earnings</h3>
        <p class="text-3xl font-bold text-orange-600">
          $<%= number_with_precision(@earnings_summary[:total_unpaid], precision: 2) %>
        </p>
        <small class="text-gray-500">Available for payout</small>
      </div>
      
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-700">Paid Earnings</h3>
        <p class="text-3xl font-bold text-green-600">
          $<%= number_with_precision(@earnings_summary[:total_paid], precision: 2) %>
        </p>
        <small class="text-gray-500">Already paid out</small>
      </div>
      
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-700">This Month</h3>
        <p class="text-3xl font-bold text-blue-600">
          $<%= number_with_precision(@earnings_summary[:this_month], precision: 2) %>
        </p>
        <small class="text-gray-500"><%= Date.current.strftime('%B %Y') %></small>
      </div>
      
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-700">Last Month</h3>
        <p class="text-3xl font-bold text-purple-600">
          $<%= number_with_precision(@earnings_summary[:last_month], precision: 2) %>
        </p>
        <small class="text-gray-500"><%= 1.month.ago.strftime('%B %Y') %></small>
      </div>
    </div>

    <!-- Breakdown Charts -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-xl font-bold text-gray-800 mb-4">Earnings by Type</h3>
        <% if @breakdown_by_type.any? { |k, v| v > 0 } %>
          <% @breakdown_by_type.each do |type, amount| %>
            <% next if amount <= 0 || type.nil? %>
            <div class="flex justify-between py-2 border-b">
              <span class="capitalize text-gray-600"><%= type&.humanize || 'Unknown' %></span>
              <span class="font-semibold text-green-600">$<%= number_with_precision(amount, precision: 2) %></span>
            </div>
          <% end %>
        <% else %>
          <p class="text-gray-500">No earnings data available</p>
        <% end %>
      </div>
      
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-xl font-bold text-gray-800 mb-4">Earnings by Shop</h3>
        <% if @breakdown_by_shop.any? %>
          <div class="space-y-3">
            <% @breakdown_by_shop.sort_by { |shop, amount| -amount }.first(5).each do |shop_domain, amount| %>
              <div class="flex justify-between items-center">
                <span class="text-gray-700 text-sm"><%= shop_domain %></span>
                <span class="font-semibold text-green-600">$<%= number_with_precision(amount, precision: 2) %></span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <div class="bg-green-500 h-2 rounded-full" 
                     style="width: <%= @breakdown_by_shop.values.max > 0 ? (amount.to_f / @breakdown_by_shop.values.max * 100).round(1) : 0 %>%"></div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-500">No shop earnings data available</p>
        <% end %>
      </div>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <%= form_with url: referral_earnings_path, method: :get, local: true, class: "flex flex-wrap gap-4 items-end" do |f| %>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
          <%= f.select :status, options_for_select([
            ['All', ''],
            ['Unpaid', 'unpaid'],
            ['Paid', 'paid']
          ], params[:status]), {}, { class: "border border-gray-300 rounded px-3 py-2" } %>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
          <%= f.select :type, options_for_select([
            ['All Types', ''],
            ['Subscription', 'subscription'],
            ['Usage', 'usage'],
            ['One-time', 'onetime']
          ], params[:type]), {}, { class: "border border-gray-300 rounded px-3 py-2" } %>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">From Date</label>
          <%= f.date_field :from_date, value: params[:from_date], 
              class: "border border-gray-300 rounded px-3 py-2" %>
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">To Date</label>
          <%= f.date_field :to_date, value: params[:to_date], 
              class: "border border-gray-300 rounded px-3 py-2" %>
        </div>
        
        <div>
          <%= f.submit "Filter", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
          <%= link_to "Clear", referral_earnings_path, 
              class: "bg-gray-300 text-gray-700 px-4 py-2 rounded hover:bg-gray-400" %>
        </div>
      <% end %>
    </div>
    
    <!-- Earnings Table -->
    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b">
        <h3 class="text-xl font-bold text-gray-800">Earnings History</h3>
      </div>
      
      <% if @earnings.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Shop</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Revenue</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Commission</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @earnings.each do |earning| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= earning.earning_date.strftime('%m/%d/%Y') %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="text-sm font-medium text-gray-900">
                      <%= earning.referral_shop.shop_domain %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800">
                      <%= earning.transaction_type&.humanize || 'Unknown' %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    $<%= number_with_precision(earning.revenue_amount, precision: 2) %>
                    <span class="text-xs text-gray-400">(<%= earning.commission_rate %>%)</span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-green-600">
                    $<%= number_with_precision(earning.commission_amount, precision: 2) %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 py-1 text-xs font-semibold rounded-full 
                      <%= case earning.payout_status&.to_s
                          when 'unpaid' then 'bg-yellow-100 text-yellow-800'
                          when 'pending_payout' then 'bg-blue-100 text-blue-800'
                          when 'paid' then 'bg-green-100 text-green-800'
                          else 'bg-gray-100 text-gray-800'
                          end %>">
                      <%= (earning.payout_status&.humanize || 'Unpaid') %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-12">
          <svg class="w-12 h-12 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          <h3 class="text-lg font-medium text-gray-900 mb-2">No earnings found</h3>
          <p class="text-gray-500 mb-4">Start referring shops to see your earnings here.</p>
          <%= link_to "Go to Dashboard", referral_dashboard_path, 
              class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>
  </div>
</body>
</html>