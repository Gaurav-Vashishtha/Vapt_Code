<!-- app/views/whatsapp_number_integration_mailer/notify_approvers.html.erb -->
<!DOCTYPE html>
<html>
<head>
  <style>
    .integration-details { 
      background: #f5f5f5; 
      padding: 20px; 
      border-radius: 8px; 
      margin: 20px 0;
    }
    .field { 
      margin: 10px 0; 
      padding: 10px;
      background: white;
      border-radius: 4px;
    }
    .label { 
      font-weight: bold; 
      color: #333;
      margin-right: 10px;
    }
    .urgent {
      background: #fff3cd;
      border-left: 4px solid #ffc107;
      padding: 10px;
      margin: 10px 0;
    }
  </style>
</head>
<body>
  <h2>New WhatsApp Number Integration Request</h2>
  
  <div class="urgent">
    <strong>⚠️ Action Required:</strong> New WhatsApp number integration request from merchant
  </div>
  
  <div class="integration-details">
    <div class="field">
      <span class="label">Shop:</span> <%= @integration_request.shop_domain %>
    </div>
    
    <div class="field">
      <span class="label">Email:</span> 
      <a href="mailto:<%= @integration_request.email %>"><%= @integration_request.email %></a>
    </div>
    
    <div class="field">
      <span class="label">Phone Number:</span> <%= @integration_request.phone_number %>
    </div>
    
    <div class="field">
      <span class="label">Preferred Time to Contact:</span> 
      <%= @integration_request.preferred_time || 'Not specified' %>
    </div>
    
    <div class="field">
      <span class="label">Requested At:</span> 
      <%= @integration_request.created_at.strftime("%B %d, %Y at %I:%M %p UTC") %>
    </div>
  </div>
  
  <p style="color: #666; font-size: 14px;">
    Please coordinate with the merchant to integrate their WhatsApp number. The agent will invite them to the operator account and guide them through the Meta Business account login process.
  </p>
</body>
</html>

