<!DOCTYPE html>
<html>
<head>
  <title>Merchant WhatsApp — Queue</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
<div class="min-h-screen bg-gray-50">
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
      <h1 class="text-xl font-semibold text-gray-900">Queue</h1>
      <%= link_to "Back", merchant_whatsapp_path, class: "text-sm border border-gray-300 rounded-md px-3 py-2 text-gray-700 hover:bg-gray-50" %>
    </div>
  </div>
  <%= render 'shared/support_navigation' %>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <% if flash[:notice].present? %><div class="mb-4 rounded-md bg-emerald-50 border border-emerald-200 px-4 py-2 text-sm text-emerald-800"><%= flash[:notice] %></div><% end %>
    <div class="bg-white rounded-lg border border-gray-200">
      <table class="w-full text-sm">
        <thead><tr class="text-left text-gray-500 border-b border-gray-100"><th class="px-4 py-2">Rule</th><th class="px-4 py-2">Domain</th><th class="px-4 py-2">Status</th><th class="px-4 py-2">Scheduled</th><th class="px-4 py-2">Note</th></tr></thead>
        <tbody>
          <% @rows.each do |row| %>
            <% rule = @rules[row.merchant_whatsapp_rule_id] %>
            <tr class="border-b border-gray-50">
              <td class="px-4 py-2"><%= rule&.name || row.merchant_whatsapp_rule_id %></td>
              <td class="px-4 py-2"><%= row.shopify_domain %></td>
              <td class="px-4 py-2"><span class="text-xs px-2 py-0.5 rounded-full <%= { 'sent' => 'bg-emerald-100 text-emerald-700', 'pending' => 'bg-blue-100 text-blue-700', 'skipped' => 'bg-gray-100 text-gray-500', 'failed' => 'bg-red-100 text-red-700' }[row.status] %>"><%= row.status %></span></td>
              <td class="px-4 py-2 text-gray-500"><%= row.scheduled_at&.strftime("%d %b %H:%M") %></td>
              <td class="px-4 py-2 text-gray-500"><%= row.skip_reason %></td>
            </tr>
          <% end %>
          <% if @rows.empty? %><tr><td colspan="5" class="px-4 py-6 text-center text-gray-400">Queue is empty. Run the scheduler or wait for the hourly job.</td></tr><% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
</body>
</html>
