{
  "config": {
    "schema": 1,
    "mode": "popup",
    "design": {
      "primary": "#111111",
      "on_primary": "#ffffff",
      "text": "#1a1a1a",
      "muted": "#6b7280",
      "background": "#ffffff",
      "surface": "#f6f6f7",
      "border": "#d9d9de",
      "error": "#d72c0d",
      "radius": 10,
      "field_radius": 8,
      "density": "comfortable",
      "header": {
        "show_title": true,
        "logo_url": "",
        "show_close": true
      },
      "sticky_submit": true,
      "hide_shipping_selector_when_single": true
    },
    "blocks": [
      {
        "id": "order_summary",
        "type": "order_summary",
        "enabled": true,
        "settings": {
          "show_image": true,
          "show_compare_at": true,
          "show_quantity": true
        }
      },
      {
        "id": "quantity_offer",
        "type": "quantity_offer",
        "enabled": true,
        "settings": {}
      },
      {
        "id": "contact",
        "type": "fields",
        "enabled": true,
        "settings": {
          "group": "contact",
          "title_key": "contact_title"
        }
      },
      {
        "id": "address",
        "type": "fields",
        "enabled": true,
        "settings": {
          "group": "address",
          "title_key": "address_title"
        }
      },
      {
        "id": "shipping",
        "type": "shipping",
        "enabled": true,
        "settings": {}
      },
      {
        "id": "bumps",
        "type": "bumps",
        "enabled": true,
        "settings": {}
      },
      {
        "id": "discount",
        "type": "discount",
        "enabled": false,
        "settings": {}
      },
      {
        "id": "totals",
        "type": "totals",
        "enabled": true,
        "settings": {
          "show_tax_line": false
        }
      },
      {
        "id": "submit",
        "type": "submit",
        "enabled": true,
        "settings": {
          "show_total_in_button": true
        }
      }
    ],
    "fields": [
      {
        "key": "first_name",
        "type": "text",
        "group": "contact",
        "enabled": true,
        "required": true,
        "width": "half",
        "autocomplete": "given-name",
        "validation": {
          "max": 60
        }
      },
      {
        "key": "last_name",
        "type": "text",
        "group": "contact",
        "enabled": true,
        "required": false,
        "width": "half",
        "autocomplete": "family-name",
        "validation": {
          "max": 60
        }
      },
      {
        "key": "phone",
        "type": "tel",
        "group": "contact",
        "enabled": true,
        "required": true,
        "width": "full",
        "autocomplete": "tel-national",
        "validation": {}
      },
      {
        "key": "email",
        "type": "email",
        "group": "contact",
        "enabled": true,
        "required": false,
        "width": "full",
        "autocomplete": "email",
        "validation": {}
      },
      {
        "key": "country",
        "type": "country",
        "group": "address",
        "enabled": true,
        "required": true,
        "width": "full",
        "validation": {}
      },
      {
        "key": "address1",
        "type": "text",
        "group": "address",
        "enabled": true,
        "required": true,
        "width": "full",
        "autocomplete": "address-line1",
        "validation": {
          "min": 3,
          "max": 120
        }
      },
      {
        "key": "address2",
        "type": "text",
        "group": "address",
        "enabled": false,
        "required": false,
        "width": "full",
        "autocomplete": "address-line2",
        "validation": {
          "max": 120
        }
      },
      {
        "key": "province",
        "type": "province",
        "group": "address",
        "enabled": true,
        "required": true,
        "width": "half",
        "validation": {}
      },
      {
        "key": "city",
        "type": "city",
        "group": "address",
        "enabled": true,
        "required": true,
        "width": "half",
        "validation": {
          "max": 80
        }
      },
      {
        "key": "zip",
        "type": "postal",
        "group": "address",
        "enabled": true,
        "required": null,
        "width": "half",
        "autocomplete": "postal-code",
        "validation": {}
      },
      {
        "key": "gst_number",
        "type": "text",
        "group": "address",
        "enabled": true,
        "required": false,
        "width": "full",
        "only_countries": [
          "IN"
        ],
        "validation": {
          "regex": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$"
        }
      },
      {
        "key": "note",
        "type": "textarea",
        "group": "address",
        "enabled": false,
        "required": false,
        "width": "full",
        "validation": {
          "max": 500
        }
      },
      {
        "key": "marketing_consent",
        "type": "consent",
        "group": "contact",
        "enabled": false,
        "required": false,
        "width": "full",
        "default_checked": false,
        "channels": [
          "sms",
          "email"
        ]
      }
    ],
    "texts": {
      "en": {
        "title": "Cash on Delivery",
        "submit": "Complete order — {total}"
      }
    },
    "thank_you": {
      "type": "order_status",
      "url": "",
      "message": {
        "en": "Thank you {first_name}! Your order {order_name} is confirmed."
      },
      "whatsapp": {
        "phone": "",
        "message": {
          "en": "Hi, I just placed order {order_name}."
        }
      }
    },
    "steps": {
      "phone_first": false
    },
    "pay_online": {
      "enabled": true
    }
  },
